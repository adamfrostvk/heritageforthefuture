trigger1 = Time > 0 && vel x < 0
x = .45

[State 5201, 3]
type = PosSet
trigger1 = 1
y = 0

[State 5201, 4]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 5201, 2]
type = PalFX
trigger1 =  animelemtime(2) = 1|animelemtime(3) = 1
time = 2
add = 128,128,128

[State 5201, 5]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; HIT_AIRFALLRECOVER
[Statedef 5210]
type    = A
movetype= I
physics = N
anim = ifelse(command = "holddown",5211,5210)
ctrl = 0

[State 5210, 音]
type = PlaySnd
trigger1 = time = 1
value = s200, 0
channel = 0

[State 5210, 1] ;Blink white
type = PalFX
trigger1 = Time = 2
trigger2 = Time = 5
time = 2
add = 128,128,128

[State 5210, 1]
type = PosFreeze
trigger1 = Time = 0
value = 4

[State 5210, 2] ;Turn if not facing opponent
type = Turn
trigger1 = Time = 0
trigger1 = p2dist X < -20

[State 5210, 6]
type = Velset
trigger1 = Time = 1
y = ifelse(command = "holddown" && command != "holdfwd" && command != "holdback",-1.2,-9)

[State 5210, 6]
type = Velset
triggerall = Time = 1
trigger1 = command = "holddown" && command != "holdfwd" && command != "holdback"
trigger2 = command != "holddown" && command != "holdup" && command != "holdfwd" && command != "holdback"
trigger3 = command = "holdup"
x = 0

[State 5210, 8]
type = Velset
trigger1 = Time = 1 && command = "holdfwd"
x = 4.5

[State 5210, 8]
type = Velset
trigger1 = Time = 1 && command = "holdback"
x = -4.5

[State 5210, 10]
type = NotHitBy
trigger1 = anim = 5210
trigger1 = animelemtime(1) >= 0 && animelemtime(6) < 0
value = SCA
time = 1

[State 5210, 10]
type = NotHitBy
trigger1 = anim = 5211
trigger1 = animelemtime(1) >= 0 && animelemtime(2) < 0
value = SCA
time = 1

[State 5210, 11]
type = VelAdd
trigger1 = Time >= 1
y = .5

[State 5210, 20]
type = CtrlSet
trigger1 = anim = 5210 && animelemtime(6) = 0
trigger2 = anim = 5211 && animelemtime(2) = 0
value = 1

[State 5210, 5] ;Land on ground
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 52 ;JUMP_LAND
ctrl = 1

