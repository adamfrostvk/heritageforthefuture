type    = S
movetype= H
physics = S
ctrl = 0

[State 5001, 1]
type = VelSet
trigger1 = Time = 0
x = Helper(10000),GetHitVar(xvel)*ifelse(facing = -1,-1,1)

[State 5001, 2]
type = ChangeAnim
trigger1 = AnimTime = 0 && Helper(10000),GetHitVar(animtype) != 2
value = 5005 + Helper(10000),GetHitVar(animtype) + (Helper(10000),GetHitVar(groundtype)=2)*10 + (Helper(10000),GetHitVar(groundtype) != 1 && var(4) = 1)*400

[State 5001, 2]
type = ChangeAnim
trigger1 = time = 0 && Helper(10000),GetHitVar(animtype) = 2 && Helper(10000),GetHitVar(animtype) = 2
value = 5007 + (Helper(10000),GetHitVar(groundtype)=2)*10 + (Helper(10000),GetHitVar(groundtype) != 1 && var(4) = 1)*400

[State 5001, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= Helper(10000),GetHitVar(slidetime)
x = .6

[State 5001, 4]
type = VelSet
trigger1 = Helper(10000),HitOver
x = 0

[State 5001, 5]
type = DefenceMulSet
trigger1 = Helper(10000),HitOver
value = 1

[State 5001, 6]
type = ChangeState
trigger1 = Helper(10000),HitOver
value = 0
ctrl = 1

