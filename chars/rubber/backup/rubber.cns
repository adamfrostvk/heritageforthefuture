;==============================================================
;var(0)ダッシュ
;var(1)～var(2)食ってやるッ！
;var(3)食らい・random
;var(4)食らい・下段くらい
;var(5)ジャンプ関連
;var(6)movecontact
;var(7)大ジャンプしたかどうか
;var(8)挑発・勝ちポーズ・random
;var(9)食ってやるッ！（ScreenBound）
;var(10)ヒット数
;var(11)～var(12)movecontactしたかどうか
;var(13)intro
;var(14)～var(17)アドバンシングガード
;var(18)～var(19)空中ハイエロフェイク
;var(20)varrandom
;var(21)～var(22)節制の結界
;var(23)～var(25)半径20Mヘドぶち吐きなッ！
;var(26)モード判別
;var(27)節制の結界（声）
;==============================================================
;helper,var(0)ダッシュ中攻撃
;helper,var(1)～var(9)ジャムにしてくれるぜェ
;helper,var(10)～var(11)食ってやるッ！
;helper,var(12)～var(21)intro
;helper,var(22)～var(24)空中ハイエロフェイク
;helper,var(25)～var(27)節制の結界
;helper,var(28)～var(36)半径20Mヘドぶち吐きなッ！
;==============================================================
;fvar(0)Vel X
;fvar(1)Vel Y
;fvar(2)Vel X（ダッシュ攻撃）
;fvar(3)画面端関係
;fvar(4)ココナッツバックブリーカー
;==============================================================
;helper,fvar(0)～fvar(3)intro
;helper,fvar(4)画面端関係
;==============================================================

[Data]
life = 1000
attack = 100
defence = 100
power = 10000
fall.defence_up = 50
liedown.time = 23
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
 volume = 0
  IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 20
air.back = 19
air.front = 19
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 1, -107
mid.pos = -1, -73
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.9
walk.back = -2.7
run.fwd  = 4.6, 0
run.back = -4.5,-3.8
jump.neu = 0,-10.4
jump.back = -2.55
jump.fwd = 2.5
runjump.back = -2.55,-8
runjump.fwd = 5,-5
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airjump.num = 0
airjump.height = 30
yaccel = .59
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = VarSet
triggerall = time = 0
trigger1 = prevstateno != [4000,4100]
v = 21
value = 0

[State 0, 1]
type = ChangeAnim
triggerall = var(21) = 0
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 1]
type = ChangeAnim
triggerall = var(21) != 0
trigger1 = (Anim != [4020,4024]) && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 4019+var(21)

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3]
type = VelSet
triggerall = time = 0
trigger1 = prevstateno = 200
x = fvar(0)

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State -2]
type = SprPriority
triggerall = numhelper(10000) = 1
trigger1 = helper(10000),stateno = 705
trigger2 = helper(10000),stateno = 715
trigger3 = helper(10000),stateno = 725
trigger4 = helper(10000),stateno = 735
trigger5 = helper(10000),stateno = 745
trigger6 = helper(10000),stateno = 1001
trigger7 = helper(10000),stateno = 2001
trigger8 = helper(10000),stateno = 2205
value = 2
ignorehitpause = 1

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, 2]
type = VelSet
triggerall = time = 0
trigger1 = prevstateno = 400
x = fvar(0)

[State 11, 3]
type = VelSet
triggerall = time = 2
trigger1 = prevstateno = 400
x = 0

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = 1
x = 0
y = 0

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(0) = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)*ifelse(var(5) > 0,1.7,1), const(velocity.jump.back.x)))
y = const(velocity.jump.y)+ifelse(command != "holdup",1.8,0)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(0) != 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)*2, const(velocity.jump.back.x)))
y = const(velocity.jump.y)+.2+ifelse(command != "holdup",1.6,0)

[State 40, 6]
type = varset
trigger1 = animtime = 0 && command != "holdup"
v = 5
value = 0

[State 40, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = N

[State 50, 1]
type = Veladd
trigger1 = 1
y = ifelse(var(5) > 0,.54,.59)

[State 50, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 3]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 4]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 5]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 52

