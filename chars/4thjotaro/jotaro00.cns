
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

;===AI(CPU)
[State 13, 1]
type = CtrlSet
trigger1 = time=0 && var(59) && prevstateno=20
value = 1

[state 3003]
type = helper
trigger1 = var(0) = 0
trigger1 = var(4) = 0
trigger1 = time > 0
trigger1 = time %600 = 0
trigger1 = numhelper(10000) = 0
name = "star platinum"
helpertype = normal
stateno = 1
id = 1
pos = 0,0
postype = p1
ownpal = 1
keyctrl = 0
pausemovetime = var(14) * 9999999999999
sprpriority = 2

[State 0, 1]
type = ChangeAnim
triggerall = var(4) = 0
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 1]
type = ChangeAnim
trigger1 = var(4) = 1
trigger1 = Anim = 5 && Anim != 2005
value = 2005

[State 0, 1]
type = ChangeAnim
triggerall = var(4) = 1
trigger1 = Anim != 2000 && Anim != 2005
trigger2 = Anim = 2005 && AnimTime = 0 ;Turn anim over
value = 2000

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State -3, Landing Sound]
type = changestate
trigger1 = ishelper
value = 10001

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

