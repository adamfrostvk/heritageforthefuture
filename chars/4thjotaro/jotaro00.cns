; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0
ctrl = !var(59)

;===AI(CPU)
[State 20, 1]
type = AssertSpecial
trigger1 = var(59)
flag = noWalk

[State 13, 1]
type = CtrlSet
triggerall = var(59)
trigger1 = roundstate>2
trigger2 = P2dist X<0
trigger3 = power<=1&&var(14)
value = 1

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd" && !var(59)
trigger2 = var(36)>=0 && var(59)
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback" && !var(59)
trigger2 = var(36)<0 && var(59)
x = const(velocity.walk.back.x)

[State 20, 4]
type = changestate
triggerall = Vel X>0 && var(59)
trigger1 = P2dist x <= 0
trigger2 = (time>=8 && ((random<70 && P2BodyDist X >140) || (random<350 && P2BodyDist X <=80) || (random<220 && P2BodyDist X <=140) || enemynear,numproj>0))
trigger3 = (time>=4&&P2bodydist X<60&&var(42)<=0)||var(44)
value = 10

[State 20, 4]
type = changestate
triggerall = Vel X<0 && var(59)
trigger1 = P2dist x <= 0
trigger2 = (time>=8 && random<250)||(time>=4&&P2bodydist X<60&&var(42)<=0)
trigger3 = backedgebodydist <=0||var(44)
value = 10

[State 20, 3]
type = ChangeAnim
triggerall = var(4) = 0
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = var(4) = 0
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 20, 3]
type = ChangeAnim
triggerall = var(4) = 1
triggerall = vel x > 0
trigger1 = Anim != 2020 && Anim != 2005
trigger2 = Anim = 2005 && AnimTime = 0
value = 2020

[State 20, 4]
type = ChangeAnim
triggerall = var(4) = 1
triggerall = vel x < 0
trigger1 = Anim != 2021 && Anim != 2005
trigger2 = Anim = 2005 && AnimTime = 0
value = 2021

[State 40, 4]
type = Velmul
trigger1 = 1
x = const(size.xscale)

