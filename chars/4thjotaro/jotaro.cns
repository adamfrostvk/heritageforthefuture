Trigger1 = animTime = 0
value = 803

;---------------------------------------------------------------------------
;カンフースロー・相手の空中の状態
;     
;     これは投げられている相手の状態ととれる行動を設定しています
;     type = SelfStateは相手のリカバー状態を設定する物でこの状態ならこれ。
;     と言うように地上近く、空中、叩きつけられた時と３つ設定しています。

[Statedef 803]
type    = A
movetype= H
physics = N
velset = -15,-6
poweradd = 0

[State 1000, 7]
type = changeanim
trigger1 = time = 0
value = 5030

[State 1000, 7]
type = changeanim
trigger1 = selfanimexist(5035)
trigger1 = anim = 5030
trigger1 = animtime = 0
value = 5035

[State 1000, 7]
type = changeanim
trigger1 = selfanimexist(5035)
trigger1 = anim = 5035
trigger1 = animtime = 0
value = 5050

[State 1000, 7]
type = changeanim
trigger1 = !selfanimexist(5035)
trigger1 = anim = 5030
trigger1 = animtime = 0
value = 5050

[State 821, 1] ;これは重力これは毎フレーム事に0.4の力が加わります
type = VelAdd
Trigger1 = 1
y = .4

[State 821, 4] 
type = SelfState
trigger1 = time >= 15
trigger1 = command = "recovery"
value = 5200 

[State 821, 4] 
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5110 

