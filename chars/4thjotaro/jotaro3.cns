;---------------------------------------------------------------------------
;カンフースロー・投げている自分
;     このステートでは相手を設定した場所に固定した後、相手を飛ばしています
;     ここで相手の動きを制御しているのはtype = TargetBindというステートです
;     これを一定時間事にやっていくと綺麗に投げ飛ばされているように見えます。
;     そしてここにはHitDefが無いのでダメージはtype = TargetLifeAddで
;     ダメージを減らしています

[Statedef 2800]
type    = S
movetype= A
physics = N
anim = 800
poweradd = 0
velset = 0,0

[State 810, State End]
type = changestate
trigger1 = time = [1,4]
trigger1 = enemy,command = "holdfwd" || enemy,command = "holdback"
trigger1 = enemy,command = "y" || enemy,command = "z" || enemy,command = "b" || enemy,command = "c"
value = 806

[State 191, 3]
type = PlaySnd
trigger1 = time = 0
value = 2,4
channel = 0

[State 191, 3]
type = PlaySnd
trigger1 = time = 42
value = 1,5

[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElem = 1
pos = 92*const(size.xscale),0

[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElem = 3
pos = 77*const(size.xscale),0

[State 810, Width 2-11]
type = Width
trigger1 = 1
edge = ceil(80*const(size.xscale))

[State 810, Hurt 11]
type = TargetLifeAdd
trigger1 = time = 42
value = -119

[State 191, Wood 1]
type = Explod
trigger1 = time = 42
anim = 830
id = 830
postype = p1
pos = ceil(78 * const(size.xscale)),ceil(-80 * const(size.yscale))
removeongethit = 1
sprpriority = 4

[State 100, 1];ko音用ヘルパー強s
type = helper
trigger1 = numhelper(16001) = 0
trigger1 = winko = 1
name = "ko"
stateno = 16006
id = 16001
sprpriority = 1
pos = 0,240
postype = p1
ownpal = 1
keyctrl = 0
ignorehitpause = 1

[State 810, State End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;カンフースロー・投げられている相手
; 
;     ここは投げられた瞬間の相手のステートです
;     たいしたことは書いてありませんがtypeがAになっている事です。
;     相手が投げれて空中にいる事を設定して次の821ステートに移動します

[Statedef 802]
type    = A
movetype= H
physics = N
velset = 0,0

[State 820, 1]
type = ChangeAnim2
Trigger1 = Time = 0
value = 802

[State 820, 1]
type = Changestate
Trigger1 = animTime = 0
value = 803

;---------------------------------------------------------------------------
;カンフースロー・相手の空中の状態
;     
;     これは投げられている相手の状態ととれる行動を設定しています
;     type = SelfStateは相手のリカバー状態を設定する物でこの状態ならこれ。
;     と言うように地上近く、空中、叩きつけられた時と３つ設定しています。

[Statedef 803]
type    = A
movetype= H
physics = N
velset = -15,-3
poweradd = 0

[State 1000, 7]
type = changeanim
trigger1 = time = 0
value = 5030

[State 1000, 7]
type = changeanim
trigger1 = selfanimexist(5035)
trigger1 = anim = 5030
trigger1 = animtime = 0
value = 5035

[State 1000, 7]
type = changeanim
trigger1 = selfanimexist(5035)
trigger1 = anim = 5035
trigger1 = animtime = 0
value = 5050

[State 1000, 7]
type = changeanim
trigger1 = !selfanimexist(5035)
trigger1 = anim = 5030
trigger1 = animtime = 0
value = 5050

[State 821, 1] ;これは重力これは毎フレーム事に0.4の力が加わります
type = VelAdd
Trigger1 = 1
y = .4

[State 821, 4] 
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5110 

