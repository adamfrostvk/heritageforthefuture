; Common state file for M.U.G.E.N beta 2002.04.14
;
; System variables usage
; ----------------------
; Var name    Type   Purpose
; --------    ----   -------
; sysvar(0)   Temp   Set by state 5081 (HITL_SLIDE) to 1 to prevent
;                    showing ground hit frame in state 5110 (HIT_LIEDOWN).
;                    Used by guarding states.
; sysvar(1)   Temp   Used by state 40 (Jump Start) amd 45 (Air Jump Start)
;                    to keep track of which way to jump.
;                    Used by state 5100 and 5110 to remember downward
;                    velocity of player just before hitting the ground.
;                    Used in state 5080 for storing the anim # to display.

; The following states have special handling within MUGEN, and should be
; overridden with caution:
; Jump Start (40): airjumping bookkeeping at time = 0
; All guard states (120-155): guard handling throughout state
; Hit_trip, shaking (5070): defence increases at time = 0
; Hit_bounce (5100): defence increases at time = 0, player becomes
;                    invincible if within 10 ticks of getting up
; Hit_liedown (5110): player changes to get-up state (5120) when ready
; Hit_getup (5120): player's defence is restored to normal at time = 0
; Hitfall_recover (5200): player's defence is restored at time = 0
; Hitfall_airrecover (5210): player's defence is restored at time = 0

;---------------------------------------------------------------------------
;立ち状態(Stand)
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[State 11, 1]
type = ChangeAnim
trigger1 = (Anim =[1,3]) && AnimTime=0
value = 0

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%64=0
value = 1

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%128=0
value = 2

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%256=0
value = 3

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 5120 && P2Dist X>=0
value = 5

[State 11, 1] ;Change from turning animation
type = Turn
trigger1 = Anim = 5120 && P2dist X<0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 5 && var(22)
value = 5+var(22)*10000

[State 0, 1]
type = ChangeAnim
trigger1 = ((Anim != [0+var(22)*10000,3+var(22)*10000]) && Anim != 5+var(22)*10000 && Anim!=10002)
trigger2 = Anim = 5+var(22)*10000 && AnimTime = 0 ;Turn anim over
trigger3 = Anim >= 10000 && !var(22)
value = 0+var(22)*10000

[State 1000, Spark]
type = Explod
trigger1 = (Anim=10000 && AnimElem=1)||(Anim=10002 && AnimElem=12)
Anim = 10001
id = 10001
pos = 0, 0
postype = p1
bindtime = -1
removetime = -1
removeongethit = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)
persistent=0

;スタンド出現エフェクト
[State 0, Helper]
type = Explod
trigger1 = var(22) && !numhelper(20000)
ID = 7900
anim = 7900
pos = ceil(-18*const(size.xscale)),ceil(0*const(size.yscale))
postype = p1
sprpriority = 5
facing = 1
scale = const(size.xscale),const(size.yscale)

;スタンド出現エフェクト
[State 0, Helper]
type = Explod
trigger1 = var(22) && !numhelper(20000)
ID = 7900
anim = 7901
pos = ceil(-18*const(size.xscale)),ceil(0*const(size.yscale))
postype = p1
sprpriority = -1
facing = 1
scale = const(size.xscale),const(size.yscale)

;スタンドON時の本体用ヘルパー
[State 0, Helper]
type = Helper
trigger1 = var(22) && !numhelper(20000)
helpertype = normal
name = "iggy"
ID = 20000
stateno = 20000
pos = ceil(0*const(size.yscale)),ceil(0*const(size.yscale))
postype = p1
facing = 1

[state 0]
type = varset
trigger1 = !var(22)&&prevstateno!=195
var(5) = Anim

[state 0]
type = varset
trigger1 = !var(22)
var(6) = AnimElemNo(0)

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 1
x = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = 1
x = ifelse(enemynear,backedgebodydist<=5||enemynear,frontedgebodydist<=5,fvar(10),0)

[state 0]
type = ChangeState
trigger1 = IsHelper
value = 20000

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
;立ち→しゃがみ(Stand to Crouch)
[Statedef 10]
type    = C
physics = C
anim = 10+var(22)*10000

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim >= 10000 && !var(22)
value = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

[State 1000, Spark]
type = Explod
trigger1 = Time=0 && numexplod(10001)
Anim = 90000
id = 10013
pos = 0, ceil(24*const(size.yscale))
postype = p1
bindtime = -1
removetime = -1
removeongethit = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)
persistent=0

[State 1000, Spark]
type = RemoveExplod
trigger1 = numexplod(10001)
id = 10001

;---------------------------------------------------------------------------
;しゃがみ状態(Crouching)
[Statedef 11]
type    = C
physics = C
anim = 11+var(22)*10000
sprpriority = 0

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[State 11, 1]
type = ChangeAnim
trigger1 = (Anim =[13,15]) && AnimTime=0
value = 11

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%64=0
value = 13

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%128=0
value = 14

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%256=0
value = 15

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && var(22)
value = 6+var(22)*10000

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6+var(22)*10000 && AnimTime = 0
trigger2 = Anim >= 10000 && !var(22)
value = 11+var(22)*10000

[State 1000, Spark]
type = Explod
trigger1 = Anim=10011 && AnimElem=1 && numexplod(10013)
Anim = 10001
id = 10013
pos = 0, ceil(24*const(size.yscale))
postype = p1
bindtime = -1
removetime = -1
removeongethit = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)
persistent=0

[State 1000, Spark]
type = RemoveExplod
trigger1 = numexplod(10001)
id = 10001

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 1
x = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = 1
x = ifelse(enemynear,backedgebodydist<=5||enemynear,frontedgebodydist<=5,fvar(10),0)

;---------------------------------------------------------------------------
;しゃがみ→立ち(Crouch to Stand)
[Statedef 12]
type    = S
physics = S
anim = 12+var(22)*10000

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim >= 10000 && !var(22)
value = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

[State 1000, Spark]
type = RemoveExplod
trigger1 = numexplod(10013)
id = 10013
;---------------------------------------------------------------------------
;歩き(Walk)
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[state 20 , playsnd]
type = PlaySnd
trigger1 = time=0 && var(22)
value = 5,12
channel = 6

[state 20 , playsnd]
type = StopSnd
trigger1 = !var(22)
channel = 6

[state 20 , playsnd]
type = PlaySnd
trigger1 = time=100*(tickspersecond/60) && var(22)
value = 5,13
channel = 6
loop = 1

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"&&time>=2
x = const(velocity.walk.fwd.x)-(var(22)*.5)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"&&time>=2
x = const(velocity.walk.back.x)-(var(22)*-.5)

[State 20, 3]
type = ChangeAnim
triggerall = command="holdfwd"
trigger1 = Anim != 20+var(22)*10000 && Anim != 5+var(22)*10000
trigger2 = Anim = 5+var(22)*10000 && AnimTime = 0
trigger3 = Anim >= 10000 && !var(22)
value = 20+var(22)*10000

[State 20, 4]
type = ChangeAnim
triggerall = command="holdback"
trigger1 = Anim != 21+var(22)*10000 && Anim != 5+var(22)*10000
trigger2 = Anim = 5+var(22)*10000 && AnimTime = 0
trigger3 = Anim >= 10000 && !var(22)
value = 21+var(22)*10000

[State 1000, Spark]
type = RemoveExplod
trigger1 = Time=0&&numexplod(10013)
id = 10013

[State 1000, Spark]
type = Explod
trigger1 = Time=0
Anim = 90000
id = 10013
pos = 0, ceil(24*const(size.yscale))
postype = p1
bindtime = -1
removetime = -1
removeongethit = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)
persistent=0

;---------------------------------------------------------------------------
;ジャンプ予備動作(Jump Start)
[Statedef 40]
type    = S
physics = S
anim = 40+var(22)*10000
ctrl = 0
sprpriority = 1

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

;~~~~~~~~~~~~~~~~~~~~~~~~
;コマンド先行入力
[state 250]
type = varset
trigger1 = time=0
var(9) = 0

;画面端ヒットバック
[state 250]
type = varset
trigger1 = time=0
fvar(10) = 0

;**AI用(ジャンプの方向)**
[State 40,1]
type = VarSet
triggerall = !(numhelper(10000) && var(27))
triggerall = fvar(38) && time=0
trigger1 = 1
sysvar(1) = 0

[State 40,2]
type = VarSet
triggerall = fvar(38) && time=0
trigger1 = ((random = [250-(P2bodydist X>ifelse(var(22),140,120))*250+((P2bodydist X=[110,140])&&var(22)),1000]) && enemy,numproj=0) || ((random = [400,1000]) && enemy,numproj>0)
trigger1 = P2BodyDist X>60 && !(P2Statetype=A && enemynear,vel Y>0 && P2BodyDist X >=80 && enemynear,Pos Y <-55)
trigger2 = P2Statetype=A && enemynear,vel Y>0 && P2BodyDist X >=80 && enemynear,Pos Y <-55
trigger3 = P2bodydist X<40 && enemynear,BackEdgeBodyDist <=20 && var(50)%2=0
trigger4 = P2bodydist X>140
trigger5 = numhelper(10000)
trigger5 = helper(10000),stateno=13050
trigger6 = numhelper(10000) && var(27)
sysvar(1) = 1

[State 40,3]
type = VarSet
triggerall = fvar(38) && enemy,numproj=0 && time=0 && !(numhelper(10000) && var(27))
trigger1 = (random = [500,1000]) && enemynear,Statetype!=A
trigger1 = (P2BodyDist X =[61,105])
trigger2 = (random = [350,1000]) && enemynear,Statetype!=A
trigger2 = P2BodyDist X <60
trigger3 = P2bodydist X<40 && enemynear,BackEdgeBodyDist <=20 && var(50)%2!=0
sysvar(1) = -1

;||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
;プレイヤー用方向判別(Player)
[State 40,SysVarSet]
type = Varset
trigger1 = Time=0 && !fvar(38)
sysvar(1) = command="holdfwd"-command="holdback"

;小・大ジャンプ用
[State 40,VarSet]
type = VarSet
trigger1 = Time=0
var(24)=0

;小・大ジャンプ用
[State 40,VarAdd]
type = VarSet
trigger1 = Time=0 && (prevstateno=[100,105])
var(24)=2

;小・大ジャンプ用
[State 40,VarAdd]
type = VarAdd
triggerall = !fvar(38)
trigger1 = AnimTime=0
trigger1 = command!="holdup"
trigger2 = (command="longjump" && fvar(2)<8) && Time=0 && (prevstateno!=[100,105])
var(24)=1+((command="longjump" && fvar(2)<8) && Time=0 && (prevstateno!=[100,105]))

;小・大ジャンプ用
[State 40,VarAdd]
type = VarAdd
triggerall = fvar(38) && (P2BodyDist X=[60,110]) && P2statetype!=A
trigger1 = AnimTime=0
var(24)=1

;大ジャンプ用
[State 40,VarAdd]
type = VarSet
trigger1 = AnimTime=0 && var(22)&&var(24)=3
trigger2 = numhelper(10000) && var(27)
var(24)=2

[State 40,VelSet]
type = VelSet
trigger1 = AnimTime=0 && var(24)<2
x = ifelse(sysvar(1)=1,const(velocity.jump.fwd.x),ifelse(sysvar(1)=-1,const(velocity.jump.back.x),0))
y = const(velocity.jump.y)*ifelse(var(24),.8,1)*ifelse(var(22),1.1,1)

[State 40,VelSet]
type = VelSet
trigger1 = AnimTime=0 && var(24)>=2
x = ifelse(sysvar(1)=1,const(velocity.runjump.fwd.x),ifelse(sysvar(1)=-1,const(velocity.jump.back.x),0))*ifelse(var(24)=2,.8,1)
y = const(velocity.jump.y)*ifelse(var(24)=2,1.25,.8)*ifelse(var(22),1.1,1)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44+var(22)*10000)
value = 44+var(22)*10000

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44+var(22)*10000)
value = 41+var(22)*10000

[State 1000,PlaySnd]
type = PlaySnd
trigger1 = Time=0
value = 10,2
channel = 1

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;ジャンプ(Jump Up)
[Statedef 50]
type    = A
physics = N

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0||Anim!=ifelse((vel x)=0, 41+var(22)*10000, ifelse((vel x)>0, 42+var(22)*10000, 43+var(22)*10000))
trigger1 = Anim!=10003
value = ifelse((vel x)=0, 41+var(22)*10000, ifelse((vel x)>0, 42+var(22)*10000, 43+var(22)*10000))
elem = ifelse(prevstateno=10790,7,1)

[State 50, 3]
type = null;ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3+var(22)*10000)
persistent = 0
value = Anim + 3+var(22)*10000

[state 50]
type = VelAdd
trigger1 = 1
y = const(movement.yaccel)*ifelse(var(22)&&anim!=10003,.95,1)

[state 50]
type = changestate
trigger1 = vel Y>0 && Pos Y>=-Vel Y
value = 52

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[State 51, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
;着地(Jump Land)
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47+var(22)*10000+((PrevStateNo=[10110,10115])||PrevStateNo=10790)*65

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[State 1000, Spark]
type = RemoveExplod
trigger1 = time=0 && numexplod(10111)
id = 10111

[state 250]
type = varset
trigger1 = time=0
fvar(12) = 0

[state 250]
type = StopSnd
trigger1 = time=0
channel = 2

[State 52, PlaySnd]
type = PlaySnd
trigger1 = time=0
value = 52, 0

[State 52, 1]
type = VelSet
trigger1 = Time = 0
x = ifelse(enemynear,backedgebodydist<=5||enemynear,frontedgebodydist<=5,fvar(10),0)+fvar(12)
y = 0

[State 52, 2]
type = PosSet
trigger1 = time=0
y = 0

[State 52, PlaySnd]
type = CtrlSet
trigger1 = time=1
value = 1

;~~~~~~~~~~~~~~~~~~~~~~~~
;コマンド先行入力
[state 250]
type = varset
trigger1 = time=0
var(9) = 0

;~~~~~~~~~~~~~~~~~~~~~~~~
[state 250]
type = ChangeAnim
trigger1 = P2dist X<0
value = 57+var(22)*10000

[state 250]
type = Turn
trigger1 = P2dist X<0

[state 250]
type = ChangeAnim
trigger1 = AnimTime = 0 && Anim=57+var(22)*10000
value = 5+var(22)*10000

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

