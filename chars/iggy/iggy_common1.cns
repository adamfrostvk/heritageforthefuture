;ダッシュ(RUN_FWD)
[Statedef 100]
type    = S
physics = N
movetype= I
ctrl = 0
velset = 0,0
anim = 100+var(22)*10000

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[state 20 , playsnd]
type = PlaySnd
trigger1 = time=0 && var(22)
value = 5,14
channel = 6

[state 20 , playsnd]
type = StopSnd
trigger1 = !var(22)
channel = 6

[state 20 , playsnd]
type = null;PlaySnd
trigger1 = time=100*(tickspersecond/60) && var(22)
value = 5,15
channel = 6
loop = 1

[state 100]
