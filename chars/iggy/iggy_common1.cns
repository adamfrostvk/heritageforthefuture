[state 100]
type= ChangeState
trigger1 = command="holdup"&&!fvar(38)
value = 40

[state 100]
type= ChangeState
trigger1 = Anim=101 && AnimTime=0
trigger2 = Anim=100+var(22)*10000 && (command="holdback"||(Time>=20&&command!="holdfwd"&&var(22)!=0))&&!fvar(38)
trigger3 = Anim=100+var(22)*10000 && AnimElemTime(1)>=0&&time>=ifelse(P2bodydist X<=10,6,10)&&random%3=0&&fvar(38)
trigger4 = Anim=100+var(22)*10000 && AnimElemTime(1)>=0&&P2movetype=A&&enemynear,time>26&&fvar(38)
value = 0
ctrl = 1

[state 100]
type= ChangeAnim
triggerall = Anim=100
trigger1 = Time>=20&&command!="holdfwd"
