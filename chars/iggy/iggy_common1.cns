[State 5030, 1]
type = VelAdd;Gravity
trigger1 = var(34)
y = ifelse(fvar(2)<=0,.5,fvar(2))

[State 5001, 1]
type = HitVelSet
triggerall = !var(34)
trigger1 = Time = 0
x = 1
y = 1

[State 5001, 1]
type = VelSet
