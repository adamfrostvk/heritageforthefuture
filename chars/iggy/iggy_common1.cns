; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[State 1000, Spark]
type = Explod
trigger1 = Time=0 && !var(22)
Anim = 120+(statetype=A)*2
id = 120
pos = 0, 0
postype = p1
bindtime = -1
removetime = -1
