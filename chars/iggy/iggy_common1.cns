y = ifelse(fvar(2)<=0,-6,fvar(1))

[State 5030, 3]
type = ChangeState
triggerall = !var(34)
triggerall = (!HitFall||var(22))
trigger1 = HitOver
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 10  ;.
value = 5040 ;HITA_RECOV

[State 5030, 3]
type = ChangeState
triggerall = var(34)
triggerall = !var(38)
trigger1 = time>=var(34)
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 10  ;.
value = 5040 ;HITA_RECOV

[State 5030, 4]
