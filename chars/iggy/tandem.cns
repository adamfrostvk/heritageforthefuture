air.velocity = -2.5,-7.0*(1.0-ifelse(root,var(16)>0,root,var(16)*.125,0))*(root,var(16)<=7)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
fall = 0
air.fall = 1
fall.xvelocity = 0
fall.yvelocity = 0
fall.recover = 1
fall.recovertime = 20+8
guard.kill = 0
p2facing = 1

