;Announce(Hit Count)
[statedef 8500]
ctrl = 0
anim = 90000

[state 8500]
type = varset
trigger1 = time=0||(parent,var(16)>var(16)&&var(16)>0)||var(16)<0
var(16) = parent,var(16)

[state 8500]
type = varset
trigger1 = var(16)>0&&(!parent,var(16)||parent,var(16)<var(16))
var(16) = -1*var(16)

[state 8500]
type = varset
trigger1 = var(16)<0
var(17) = -1*var(17)

[state 8500]
