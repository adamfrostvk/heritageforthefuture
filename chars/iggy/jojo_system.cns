trigger1 = !var(22) && stateno!=[120,159]
trigger2 = var(22)
id = 130

;羽根消去
[State 1000, Spark]
type = RemoveExplod
trigger1 = numexplod(10001) && (anim!=[10000,10011]) && anim!=10002
id = 10001

;羽根消去
[State 1000, Spark]
type = RemoveExplod
trigger1 = numexplod(10013) && (anim!=[10000,10021])
id = 10013

;つかみ手消去
[State 1000, Spark]
type = RemoveExplod
trigger1 = numexplod(10790) && ((anim!=[10110,10115])||Anim!=10791)
id = 10790

;SON歩き・ダッシュ音停止~~~
[state -2]
type = StopSND
trigger1 = (stateno!=[20,23]) && (stateno!=[100,105])
channel = 6

;サンドストーム残像消去
[State 1000, Spark]
type = AfterImageTime
trigger1 = stateno!=900&&stateno!=[13100,13199]
time = 0

;スタンド表示優先度
[State 1000, Spark]
type = SprPriority
trigger1 = var(22)&&movetype!=A&&teamside=2
value = -1

;スタンドは影なし
[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22) && Movetype=H
flag = noshadow

;強制スタンドOFF
[State 0, 1]
type = ChangeAnim
trigger1 = var(22) && movetype=H&&((stateno!=[5000,5099])&&(stateno!=[150,155]));投げられ時
trigger2 = var(22) && (stateno=[5100,5999]) && stateno!=5210;投げられ時
trigger3 = var(22) && !Alive;KOされ時
value = var(5)
elem = var(6)

;強制スタンドOFF
[State 0, 1]
type = VarSet
trigger1 = var(22) && movetype=H&&((stateno!=[5000,5099])&&(stateno!=[150,155])&&(stateno!=[0,40]));投げられ時
trigger2 = var(22) && (stateno=[5100,5999]) && stateno!=5210;投げられ時
trigger3 = var(22) && !Alive;KOされ時
var(22) = 0

;スタンド行動時本体表示優先度
[State 1000, Spark]
type = SprPriority
trigger1 = !var(22)&&numHelper(10000) && Anim<10000
value = 4

[state -2]
type = varset
trigger1 = movetype=H||(stateno=[0,52])
var(12) = 0

[state -2]
type = varset
trigger1= !var(16)
var(17) = 0

[state 80000]
type = RemoveExplod
trigger1 = numexplod(8350) && (!var(22) || MatchOver)
id = 8350
ignorehitpause=1

;---------スタンドゲージ処理-----------

;スタンドゲージ最大値
[State -2,stand_gauge]
type = VarSet
trigger1 = RoundState<2 && var(23)=0
trigger2 = RoundState=2 && var(23)>=80
var(23) = 80

;スタンドゲージ減少
[State -2,stand_gauge]
type = VarSet
trigger1 = var(22) && !gethitvar(damage) && (stateno=150||stateno=152||stateno=154)&&time=0
var(23) = var(23)-1

;スタンドゲージ減少
[State -2,stand_gauge]
type = VarSet
trigger1 = var(22) && gethitvar(damage)
var(23) = ifelse((var(23)-(ceil(GetHitVar(Damage)/ifelse((stateno=[150,153]),7,14))+(4-(stateno=[150,155])*3)))<=0,-1,var(23)-(ceil(GetHitVar(Damage)/ifelse((stateno=[150,153]),7,14))+(4-(stateno=[150,155])*3)))

;スタンドゲージ回復
[State -2,stand_gauge]
type = VarAdd
trigger1 = !var(22) && (var(23)=[0,80)) && gametime%2=0 && !(StateNo=2000 && time>=123)
var(23) = 1

;スタンドクラッシュへ
[State -2,stand_clash]
type = ChangeState
trigger1 = var(22) && var(23)=-1 && (StateNo!=[5910,5939]) && !(StateNo=2000 && time>=123)
value = 5910+(StateType=C)*10+(StateType=A)*20

[State 5300,varset]
type = varSet
trigger1 = var(23)<0&&(stateno!=[5910,5930])
var(23)=0

;------
;本体モード時スタンド食らい
[State 200,StateTypeSet]
type = ChangeState
trigger1 = numhelper(10000)
trigger1 = helper(10000),stateno=15000&&helper(10000),time=1
trigger1 = var(34)&&(stateno!=5000&&stateno!=5010&&stateno!=5020&&stateno!=5070)
value = ifelse((statetype!=A&&var(36)=3)||(statetype=A&&var(37)=3),5070,5000+((statetype=C)*10+(statetype=A)*20))

;SON時は削り無効化
[State 1000, Spark]
type = LifeAdd
trigger1 = var(22)
trigger1 = stateno=150||stateno=152||stateno=154
value = gethitvar(damage)

;タンデムランダム
[State 0, Helper]
type = varset
trigger1 = numhelper(10000)
trigger1 = helper(10000),var(28)>0
var(28) = helper(10000),var(28)

;タンデム中判別
[State 0, Helper]
type = varadd
trigger1 = !numhelper(10000)&&var(27)>0&&stateno!=2000
var(27) = -1

;---KO関係----
;犬
[state -1]
type = helper
trigger1 = !numhelper(6300) && ((Anim=[3110,3111]) || (Anim=[13110,13111])) && winko
stateno=6300
id = 6300
name = "Dog"
helpertype=Normal
keyctrl = 0
pos = 0,0
postype = P1
persistent = 0

;ラウンド開始前、試合終了後はライフバー非表示
[State 1000, Spark]
type = AssertSpecial
trigger1 = RoundState<2
trigger2 = MatchOver
flag = nobardisplay

;KOエフェクト
[State 0, Helper]
type = Helper
trigger1 = !numhelper(8600)
trigger1 = RoundState>2 && WinKO && Alive
helpertype = normal
name = "finish"
ID = 8600
stateno = 8600
pos = 0,0
postype = back
facing = 1
ownpal = 1
size.xscale = 1
size.yscale = 1
ignorehitpause =1

;敗北カットイン
[State 0, Helper]
type = Helper
triggerall = !numhelper(8650)
triggerall = RoundState>=3 && LoseKO && !Alive
trigger1 = (enemynear,stateno%10000=[2000,4999])||(enemynear,HitDefAttr=SCA,HA,HT,HP)
trigger2 = (enemynear,stateno%10000=[2000,4999])&&(enemynear,HitDefAttr=SCA,NA,NT,NP)
helpertype = normal
name = "lose"
ID = 8650
stateno = 8650
pos = 0,0
postype = back
bindtime=1
ownpal = 1
ignorehitpause =1

