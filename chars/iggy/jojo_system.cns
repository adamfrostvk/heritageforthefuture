;コマンド受付（通常技・特殊技）
[State 0, Helper]
type = varset
trigger1 = !fvar(38) && Time>=4&&(command="x"||command="y"||command="z"||command="b")
var(27) = ifelse(command="x"||command="b",1,ifelse(command="y",2,ifelse(command="holdfwd"&&command!="holddown",5,3)))+(command="holddown")*10

;コマンド受付（サンドアタック）
[State 0, Helper]
type = varset
trigger1 = !fvar(38) && Time>=4&&command="attack2"
var(27) = ifelse(command="x"||command="b",1101,ifelse(command="y",1102,1103))

