trigger1 = !fvar(38) && Time>=4&&command="wave"
var(27) = ifelse(command="x"||command="b",3001,3002)

;入力音
[state 2000]
type = PlaySND
trigger1 = !fvar(38) && Time>=4&&var(27)
value = 2000,ifelse(var(27)<30,ifelse(var(27)=20,1,ifelse(var(27)=5,2,var(27)%10-1)),var(27)%10-1)
channel = 20

;AI用
[State 0, Helper]
type = varset
trigger1 = fvar(38) && Time>=4&&time%6=0 && numhelper(10000)
trigger1 = helper(10000),var(3)<15
var(27) = ifelse(time%18=6,11,ifelse(time%18=12,2,3))

;AI用
[state 2000]
type = PlaySND
trigger1 = fvar(38) && Time>=4&&time%6=0 && numhelper(10000)
trigger1 = helper(10000),var(3)<15
value = 2000,ifelse(time%18=6,1,ifelse(time%18=12,2,3))
channel = 20

