;アドバンシングガード相手押し用ヘルパー(Advancing Guard Helper)
[statedef 925]
ctrl = 0
velset = 0,0
anim = 925

[state 8500]
type = posset
trigger1 = time=0
x = floor(enemynear,pos x)

[state 8500]
type = posadd
trigger1 = time=0
x = -(enemynear,const(size.ground.front))

[state 8500]
type = velset
trigger1 = time=1
x = 20.0*const(size.xscale)

[state 8500]
type = velMul
trigger1 = time>1
x = .9

[state 8500]
type = velset
trigger1 = time=17
x = 0

[state 8500]
type = PlayerPush
trigger1 = 1
value = ifelse(time>16,0,1)

[state 8500]
type = NotHitBy
trigger1 = 1
value = SCA

[state 8500]
type = HitOverride
trigger1 = 1
value = SCA,AA,AT,AP
stateno=925
slot = 0
time=1

[state 8500]
type = PlaySND
trigger1 = time=0
value = 0,1
channel = 4

[state 8500]
type = varset
trigger1 = time>1
var(5) = 1

[state 8500]
type = DestroySelf
trigger1 = time>16

