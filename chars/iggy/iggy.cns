;歩き（前）（CPU）
[Statedef 21]
type    = S
physics = N
sprpriority = 0
ctrl = 0

[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[state 20 , playsnd]
type = PlaySnd
trigger1 = time=0 && var(22)
value = 5,12
channel = 6

[state 20 , playsnd]
type = StopSnd
trigger1 = !var(22)
channel = 6

[state 20 , playsnd]
type = PlaySnd
trigger1 = time=100*(tickspersecond/60) && var(22)
value = 5,13
channel = 6
loop = 1

[State 1000, Spark]
type = RemoveExplod
trigger1 = Time=0&&numexplod(10013)
id = 10013

[State 1000, Spark]
type = Explod
trigger1 = Time=0
Anim = 90000
id = 10013
pos = 0, ceil(24*const(size.yscale))
postype = p1
bindtime = -1
removetime = -1
removeongethit = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)
persistent=0

[State 20, 1]
type = VelSet
trigger1 = time>=2
x = const(velocity.walk.fwd.x)

[State 20, 3]
type = ChangeAnim
trigger1 = time=0
value = 20+var(22)*10000

[State 20, 4]
type = changestate
trigger1 = P2dist x <= 0
value = 0
ctrl = 1

[State 20, 4]
type = changestate
trigger1 = time>=1 && fvar(35)
trigger2 = (P2BodyDist X>40 && time>=8)||(P2bodydist X<=40&&time>=6)
trigger2 = ((P2BodyDist X <80&&random<500) || (random<200 && P2BodyDist X =[80,120]) || (random<160 && (P2BodyDist X =[120,160])) || (random<70 && P2BodyDist X >160))
trigger3 = P2BodyDist X>40 && time>=4
trigger3 = (P2bodydist X>120&&(enemy,numproj>0||(enemy,numhelper&&inguarddist))&&random<400)
value = 13
;----------------------------------------------------------------------

