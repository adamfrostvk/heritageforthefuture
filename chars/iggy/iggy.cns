;勝利ポーズ(Winning Pose)
[Statedef 180]
type = S
movetype = I
velset = 0,0
ctrl = 0

[State 180, 0]
type = ChangeAnim
trigger1 = time=0 && !var(22)
value = 180+random%2

[State 180, 0]
type = ChangeAnim
trigger1 = time=0 && var(22) && Anim!=10000 && Anim!=10002
value = 10000

[State 1000,PlaySnd]
type = PlaySnd
trigger1 = Anim = 180 && AnimElem=9
trigger2 = Anim = 181 && AnimElem=1
value = 10,2
channel = 1

[State 1000, Spark]
type = Explod
trigger1 = ((Anim=10000 && AnimElem=1)||(Anim=10002 && AnimElem=12)) && (prevstateno!=11&&prevstateno!=13) && !NumExplod(10001)
Anim = 10001
id = 10001
pos = 0, 0
postype = p1
bindtime = -1
removetime = -1
removeongethit = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)
persistent=0

[State 180, 0]
type = NotHitBy
trigger1 = 1
value = SCA

[State 190,1]
type = AssertSpecial
trigger1 = (Time=[0,200]) && var(22)
flag = noshadow
flag2 = RoundNotOver

[State 190,1]
type = AssertSpecial
trigger1 = (Time=[0,200]) && !var(22)
flag = RoundNotOver

