trigger1 = Anim=190 && Time = 0
x = -56
y = -112

[State 1000, Spark]
type = Helper
trigger1 = Anim=190 && Time=0
helpertype = normal
id = 10000
stateno = 10190
pos = 0, 0
postype = p1

[State 1000,PlaySnd]
