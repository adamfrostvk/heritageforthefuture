;_/_/_/_/CPU_/_/_/_/
;---------------------------------------------------------------------------
;立ち状態(ＣＰＵ)
[Statedef 3]
type    = S
physics = S
anim = 0
sprpriority = 0
velset = 0,0
ctrl =0

[State 13, 1]
type = ChangeAnim
trigger1 = P2Dist X<0
value = 5

[State 13, 1]
type = Turn
trigger1 = P2Dist X<0

;--------
[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[State 11, 1]
type = ChangeAnim
trigger1 = (Anim =[1,3]) && AnimTime=0
value = 0

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%64=0
value = 1

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%128=0
value = 2

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%256=0
value = 3

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 5120 && P2Dist X>=0
value = 5

[State 11, 1] ;Change from turning animation
type = Turn
trigger1 = Anim = 5120 && P2dist X<0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 5 && var(22)
value = 5+var(22)*10000

[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != 0+var(22)*10000 && Anim != 5+var(22)*10000 && Anim!=10002)
trigger2 = Anim = 5+var(22)*10000 && AnimTime = 0 ;Turn anim over
trigger3 = Anim >= 10000 && !var(22)
value = 0+var(22)*10000

[State 1000, Spark]
type = Explod
trigger1 = (Anim=10000 && AnimElem=1)||(Anim=10002 && AnimElem=12)
Anim = 10001
id = 10001
pos = 0, 0
postype = p1
bindtime = -1
removetime = -1
removeongethit = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)
persistent=0

;スタンド出現エフェクト
[State 0, Helper]
type = Explod
trigger1 = var(22) && !numhelper(20000)
ID = 7900
anim = 7900
pos = ceil(-18*const(size.xscale)),ceil(0*const(size.yscale))
postype = p1
sprpriority = 5
facing = 1
scale = const(size.xscale),const(size.yscale)

;スタンド出現エフェクト
[State 0, Helper]
type = Explod
trigger1 = var(22) && !numhelper(20000)
ID = 7900
anim = 7901
pos = ceil(-18*const(size.xscale)),ceil(0*const(size.yscale))
postype = p1
sprpriority = -1
facing = 1
scale = const(size.xscale),const(size.yscale)

;スタンドON時の本体用ヘルパー
[State 0, Helper]
type = Helper
trigger1 = var(22) && !numhelper(20000)
helpertype = normal
name = "iggy"
ID = 20000
stateno = 20000
pos = ceil(0*const(size.xscale)),ceil(0*const(size.yscale))
postype = p1
facing = 1

[state 0]
type = varadd
trigger1 = time
var(11) = 1

[state 0]
type = varset
trigger1 = animtime=0
var(11) = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0
;-----------

[State 13, 1]
type = ChangeState
trigger1 = roundstate!=2
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;しゃがみ状態(ＣＰＵ)
