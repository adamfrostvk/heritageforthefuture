;~~~相手側のhitpause作成~~
[state 250]
type = varset
trigger1 = time=0
fvar(9) = 100

[state 250]
type = varset
trigger1 = movecontact=1
fvar(9) = 10

[state 250]
type = varadd
trigger1 = movecontact&&fvar(9)>=0
fvar(9) = -1

[state 250]
type = varset
trigger1 = movecontact&&((enemynear,prevstateno=[5000,5099])||(enemynear,prevstateno=[150,155]))&&P2movetype!=H&&fvar(9)>0
fvar(9) = 0
;~~~~~~~~~~~~~~~~~~~~~~

[State 0, HitDef]
type = HitDef
triggerall = (var(10)<=0||!movecontact)
trigger1 = AnimElem=5
attr = S,NA        ;SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
hitflag = MAF        ;HLAFD+-
guardflag = M         ;HLA
getpower = 4*ifelse(Power%4<2,10,9),0
givepower = 2*ifelse(Power%4<2,10,9),0
animtype = light          ;light,medium,hard,back,up,diagup
air.animtype = back
;fall.animtype = Back
damage = ifelse(floor((4+(prevstateno=10200))*fvar(7))<1,1,floor((4+(prevstateno=10200))*fvar(7)))*7,ifelse(ceil((4+(prevstateno=10200))*(1.0/5))<1,1,ceil((4+(prevstateno=10200))*(1.0/5)))*7
pausetime = 1,10
sparkno = -1
guard.sparkno = -1
sparkxy = ifelse((Abs(P2bodydist X)-10)<20,-20,-10),ceil(-16*const(size.yscale))
hitsound = -1;s1,0
guardsound = -1;s0,0
ground.type = Low
ground.slidetime = 10
ground.hittime = 10
guard.slidetime = 10
guard.hittime = 10
yaccel = .4
ground.velocity = -6.5*const(size.xscale)
air.velocity = -2.5,-7.0*(1.0-ifelse(var(16)>0,var(16)*.125,0))*(var(16)<=7)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
fall = 0
air.fall = 1
fall.xvelocity = 0
fall.yvelocity = 0
fall.recover = 1
fall.recovertime = 20+8
guard.kill = 0

;~~コマンド先行入力~~
