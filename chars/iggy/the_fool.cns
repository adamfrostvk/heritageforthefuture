;---------------------------------------------------------------------------
;スタンドモード時の本体用ヘルパー
[Statedef 20000]
type = S
physics = N
velset = 0,0
;ownpal = root,stateno=10950

;スタンドより手前に表示
[state 0]
type = SprPriority
trigger1 = root,stateno!=[120,159]
value = ifelse(teamside=1,3,2)

;ガード時はスタンドより奥に表示
[state 0]
type = SprPriority
trigger1 = root,stateno=[120,159]
value = ifelse(teamside=1,0,-1)

;振り向き
[State 0, 1]
type = ChangeAnim
trigger1 = facing != root,facing && (root,ctrl||(root,stateno=[0,41]))
value = 5+(root,statetype=C)

;振り向き
[State 0, 1]
type = Turn
trigger1 = facing != root,facing && (root,ctrl||(root,stateno=[0,41]))

;本体のステートによってアニメ変更
[State 0, 1]
type = ChangeAnim
trigger1 = Anim!=(root,anim-10000+((root,Anim=[11000,15000)))*50)&&!(Anim=0&&Root,StateType=A&&(Root,Ctrl||(Root,StateNo=[10600,10620])))&&!((Anim=[1,3])&&(root,anim=10000||root,anim=10002))
trigger1 = root,stateno!=180&&root,stateno!=195&&!(root,stateno=195&&root,prevstateno=195)&&(root,stateno!=[170,175])&&root,stateno!=810
trigger1 = !((root,anim=[10200,10699])&&((root,statetype=S&&Anim=0)||(root,statetype=C&&Anim=11)))
trigger1 = !((Anim=[41,46])&&root,statetype=A&&((root,stateno=[41,51])||(root,stateno=[10600,10699])))
trigger1 = (SelfAnimexist(root,anim-10000+((root,Anim=[11000,15000)))*50)||root,anim=10002)
value = ifelse((root,anim=[10120,10699])||root,anim=10002,ifelse(root,statetype=S,0,ifelse(root,statetype=A,41,11)),ifelse(root,anim=10002&&root,var(5)<195,0,root,anim-10000))+((root,Anim=[11000,15000)))*50

;本体のステートによってアニメ変更
[State 0, 1]
type = ChangeAnim
trigger1 = Anim!=0 && Root,StateType=A && Root,Anim=10003
value = 0

;本体のステートによってアニメ変更(投げ)
[State 0, 1]
type = ChangeAnim
trigger1 = Anim!=850 && Root,stateno=810
value = 850

;空中2強へ
[State 0, 1]
type = ChangeState
trigger1 = Root,stateno=10720
value = 720

;サンドストーム成功動作へ
[State 0, 1]
type = ChangeState
trigger1 = Root,stateno=13110
value = 3110
;-------------

;サンドクラッチ成功(いびき)
[State 1000,PlaySnd]
type = PlaySnd
trigger1 = Anim=1290 && AnimElem=9,=0
value = 10,4
channel = 1

;挑発中にSONした時のアニメ変更
[State 0, 1]
type = ChangeAnim
trigger1 = root,stateno=195&&root,animelem=1&&root,anim=10002
value = root,var(5)
elem = root,var(6)

;挑発用ランダムアニメ
[State 0, 1]
type = ChangeAnim
trigger1 = root,stateno=195&&root,time=1
value = 195+random%3

;挑発用ボイス
[State 1000,PlaySnd]
type = PlaySnd
trigger1 = Anim=196 && root,time=1 && root,stateno=195 && root,AnimElemTime(3)<0
value = 10,3
channel = 1

;挑発用(いびき)
[State 1000,PlaySnd]
type = PlaySnd
trigger1 = Anim=197 && AnimElem=8 && root,anim!=10002 && root,stateno=195
value = 10,4
channel = 1

;挑発用(鼻提灯)
[State 1000, Spark]
type = Explod
trigger1 = Anim=197 && AnimElem=8 && root,anim!=10002 && root,stateno=195
Anim = 6100
id = 6100
pos = 0, 0
postype = p1
bindtime = -1
removeongethit = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)

;挑発用アニメ変更
[State 0, 1]
type = ChangeAnim
trigger1 = Anim = 195 && AnimTime=0
value = 0

;時間切れ負け用ランダムアニメ
[State 0, 1]
type = ChangeAnim
trigger1 = (root,stateno=[170,175])&&root,time=1
value = 170

;勝利ポーズ用ランダムアニメ
[State 0, 1]
type = ChangeAnim
trigger1 = root,stateno=180&&root,time=1
value = 180+random%2

;勝利ポーズボイス
[State 1000,PlaySnd]
type = PlaySnd
trigger1 = Anim = 180 && AnimElem=9
trigger2 = Anim = 181 && AnimElem=1
value = 10,2
channel = 1

;本体のステートによってアニメ変更
[state 0,1]
type = ChangeAnim
trigger1 = ((time=0&&anim=0)||(animtime=0&&(anim=[1,3]))) && root,var(5)<195
value = root,var(5)
elem = root,var(6)

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%256=0 && Root,statetype!=A && root,stateno=0 && root,var(5)<195
value = 3

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%64=0 && Root,statetype!=A && root,stateno=0 && root,var(5)<195
value = 1

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%128=0 && Root,statetype!=A && root,stateno=0 && root,var(5)<195
value = 2

;本体用ヘルパーのアニメ番号判別
[state 0]
type = parentvarset
trigger1 = !((root,var(5)=[195,199])&&Root,stateno=195&&Root,Ctrl)
var(5) = anim

;本体用ヘルパーのアニメ時間(AnimElem)判別
[state 0]
type = parentvarset
trigger1 = !((root,var(5)=[195,199])&&Root,stateno=195&&Root,Ctrl)
var(6) = animelemNo(0)

;本体用ヘルパーのアニメ番号判別
[state 0]
type = parentvarset
trigger1 = !((root,var(5)=[195,199])&&Root,stateno=195&&Root,Ctrl)&&((Anim=1&&AnimElemtime(4)>=0)||(Anim=2&&AnimElemtime(12)>=0)||(Anim=3&&AnimElemtime(9)>=0))
var(5) = 0

;本体用ヘルパーのアニメ番号判別
[state 0]
type = parentvarset
trigger1 = !((root,var(5)=[195,199])&&Root,stateno=195&&Root,Ctrl)&&((Anim=1&&AnimElemtime(4)>=0)||(Anim=2&&AnimElemtime(12)>=0)||(Anim=3&&AnimElemtime(9)>=0))
var(6) = 1

;---HitPause処理---
[state 250]
type = ChangeAnim
trigger1 = root,movecontact && root,var(10)>ifelse(animelemtime(3)<0,3,0); && root,var(10)>var(8)
trigger2 = root,animelemtime(5)=0 && root,stateno=13000
trigger3 = root,animelemtime(22)=0&&animelemno(0)=12 && root,stateno=13000
value = anim
elem = ifelse(root,animelemtime(22)>=0&&animelemNo(0)=12&&root,stateno=13000,13,AnimElemNo(0));ifelse(AnimElemNo(0)=var(7),AnimElemNo(0),AnimElemNo(-1))

[state 250]
type = varset
trigger1 = root,var(10)<=0||!root,movecontact
var(7) = AnimElemNo(0)

[state 250]
type = varset
trigger1 = root,var(10)<=0||!root,movecontact
var(8) = AnimElemTime(AnimElemNo(0))
;--------

;本体用ヘルパーは無敵
[State 0, 4]
type = NotHitBy
trigger1 = 1
value = SCA
time = -1

;常時本体に固定
[State 0, 4]
type = BindToRoot
trigger1 = root,stateno!=10720
pos = ceil(-18*const(size.xscale)),0
time = 1

;---ビッグサンドウェーブ用---

[State 0, 4]
type = VarSet
trigger1 = Anim=3050 && AnimElem=3
fvar(11) = -12.0

[State 0, 4]
type = VarAdd
triggerall = Anim=3050
trigger1 = AnimElemTime(3)>0 && AnimElemTime(11)<0
fvar(11) = .5

[State 0, 4]
type = Varset
trigger1 = Anim=3050 && AnimElem=11
fvar(11) = 0

[State 0, 4]
type = VarSet
trigger1 = Anim=3050 && AnimElem=13
fvar(11) = -3.0

[State 0, 4]
type = VarAdd
triggerall = Anim=3050
trigger1 = AnimElemTime(13)>0 && AnimElemTime(29)<0
fvar(11) = .75

[State 0, 4]
type = VarAdd
trigger1 = Anim=3050
fvar(10) = fvar(11)

[State 0, 4]
type = OffSet
trigger1 = Anim=3050
y = ceil(fvar(10)*const(size.yscale))

;高さ０
[State 0, 4]
type = VarSet
trigger1 = Anim!=3050
trigger2 = Anim=3050 && AnimElem=1
trigger3 = Anim=3050 && AnimElem=29
fvar(10) = 0

;速度０
[State 0, 4]
type = VarSet
trigger1 = Anim!=3050
trigger2 = Anim=3050 && AnimElem=1
trigger3 = Anim=3050 && AnimElem=29
fvar(11) = 0

;[State 0, explod]
;type = Explod
;trigger1 = root,stateno=10950
;pos = ceil(-18*const(size.xscale)),0

