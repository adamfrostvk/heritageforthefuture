type = A
movetype = H
physics = N

[State 0, end]
type = changestate
trigger1 = !alive
value = 15050

[State 0, anim]
type = changeanim
trigger1 = !animtime
trigger1 = anim != 5040
trigger2 = !time
trigger2 = anim != 5035
value = 5040

[State 0, state]
type = statetypeset
trigger1 = helper(10000),HitOver
movetype = I

