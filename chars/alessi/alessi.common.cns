triggerall = helper(10000),GetHitVar(fall)
trigger1 = helper(10000),HitOver
trigger2 = vel y > 0
trigger2 = pos y >= 10
value = ifelse(var(0)&&alive&&helper(20032),fvar(6),15040,15050)

[State 0, end]
type = changestate
triggerall = numhelper(20032)
trigger1 = !animtime
value = ifelse(var(0)&&alive&&helper(20032),fvar(6),15040,15035)

