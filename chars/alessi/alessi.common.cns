;---------------------------------------------------------------------------
;Stand
[Statedef 0]
type = S
movetype = I
physics = S
velset = 0,0
sprpriority = 0+(var(0)>0)*1

[State 0, 4]
type = sprpriority
trigger1 = 1
value = 0

[State 0, 4]
type = ChangeAnim
triggerall = !var(13)
trigger1 = anim != 10002
trigger1 = (anim = [10000,10047])
value = 10002

[State 0, 4]
type = ChangeAnim
triggerall = var(13)
trigger1 = anim = 5
value = 5+var(13)

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0+var(13) && Anim != 5+var(13) && Anim != 10002
trigger2 = Anim = 5+var(13) && AnimTime = 0 ;Turn anim over
trigger3 = Anim = 10002 && AnimTime = 0
value = 0+var(13)

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, vel]
type = velset
trigger1 = !time
y = 0

[State 0, end]
type = changestate
trigger1 = !alive
value = 5050

[State 0, end]
type = DestroySelf
trigger1 = IsHelper

;---------------------------------------------------------------------------
;腕表示
[Statedef 7]
type = S
movetype = I
physics = N
velset = 0,0
sprpriority = 1+(root,var(0)>0)

[State 0, 4]
type = turn
trigger1 = facing != root,facing

[State 0, 4]
type = bindtoroot
trigger1 = 1
pos = 0,0

;スタンド影消し
[state -2, assert]
type = assertspecial
trigger1 = root,var(0)
flag = Noshadow
ignorehitpause = 1

[State 0, 4]
type = ChangeAnim
trigger1 = !time
value = 1

[State 0, anim]
type = changeanim
trigger1 = (root,var(6)&128)
trigger2 = root,var(8)
value = anim
elem = animelemno(0)

[State 0, var]
type = parentvarset
trigger1 = 1
var(12) = 1

[State 0, end]
type = DestroySelf
trigger1 = root,anim != 0
trigger1 = !(root,anim=2200||root,anim=2210||root,anim=2212||root,anim=2217||root,anim=2220||root,anim=2205||root,anim=2215||root,anim=2225||root,anim=10800)
trigger2 = root,movetype = H

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10+var(13)
sprpriority = 0+(var(0)>0)*1

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11+var(13)
sprpriority = 0+(var(0)>0)*1

[State 0, 4]
type = ChangeAnim
triggerall = var(13)
trigger1 = Anim = 6
value = 6+var(13)

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6+var(13) && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = ifelse(anim>10000,10012,12)
sprpriority = 0+(var(0)>0)*1

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0+(var(0)>0)*1

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = anim != 10020
triggerall = vel x > 0
trigger1 = Anim != 20+var(13) && Anim != 5+var(13)
trigger2 = Anim = 5+var(13) && AnimTime = 0
value = 20+var(13)

[State 20, 4]
type = ChangeAnim
triggerall = anim != 10021
triggerall = vel x < 0
trigger1 = Anim != 21+var(13) && Anim != 5+var(13)
trigger2 = Anim = 5+var(13) && AnimTime = 0
value = 21+var(13)

;---------------------------------------------------------------------------
;ジャンプ開始
[Statedef 40]
type    = S
physics = N
anim = 40+var(13)
ctrl = 0
velset = 0,0
sprpriority = 0+(var(0)>0)*1

[State 40, HitBy]
type = HitBy
trigger1 = 1
value = SCA, NA,SA,HA,NP,SP,HP

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = command = "holdfwd"-command = "holdback"

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(6) = (var(6)|4|8)-4-8

[State 40, 4]
type = VarSet
triggerall = Time = 0
trigger1 = PrevStateNo != 100 && PrevStateNo != 105
trigger1 = Command = "longjump"
var(6) = (var(6)|4)

[State 40, 4]
type = VarSet
triggerall = Time = 0
trigger1 = PrevStateNo = 100 || PrevStateNo = 105
var(6) = (var(6)|8)

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(6)=(var(6)|16)-16

[State 40, 5]
type = VarSet
trigger1 = command != "holdup"
var(6) = (var(6)|16)

[State 40, 6]
type = VelSet
trigger1 = time = 0 && !var(0)
x = ifelse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))*ifelse((var(6)&4),1.6,ifelse((var(6)&8),1.33,1))

[State 40, 6]
type = VelSet
trigger1 = time = 0 && var(0)
x = ifelse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))*ifelse((var(6)&4),.9,ifelse((var(6)&8),1.33,1))

[State 40, 8]
type = VelSet
trigger1 = time = 0
y = const(velocity.jump.y)*ifelse((var(6)&4),1.1,1)*ifelse(var(0)=10000,1.05,1)-((var(6)&4)&&var(0))*1

[State 40, 8]
type = VelMul
trigger1 = (var(6)&4) && sysvar(1) = -1
x = .64
persistent = 0

[State 40, 8]
type = VelMul
trigger1 = (var(6)&16)
y = .64
persistent = 0

[State 40, 10]
type = PosFreeze
trigger1 = 1

[State 40, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;ジャンプ
[Statedef 50]
type    = A
physics = N
sprpriority = 0+(var(0)>0)*1

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41+var(13), ifelse((vel x)>0, 42+var(13), 43+var(13)))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State -3, Variable Height]
type = PlayerPush
triggerall = statetype=A && movetype!=H && numenemy
triggerall = p2bodydist x = [-(enemynear,const(size.ground.back) + enemynear,const(size.ground.front)), 0]
trigger1 = p2statetype=S
trigger1 = p2dist y >= (enemynear,const(size.height) - 12); Value depends on each char
trigger2 = p2statetype=C
trigger2 = p2dist y >= (enemynear,const(size.height) - 28); Value depends on each char
trigger3 = p2statetype=L
trigger3 = p2dist y >= 12
value=0
ignorehitpause=1

[State 4030, Gravity]
type = VelAdd
trigger1 = 1
y = ifelse((var(6)&16),.45,.55)

[State 1100, ChangeState]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 52

;---------------------------------------------------------------------------
;Jump Land
[Statedef 52]
type = S
physics = S
ctrl = 0
velset = 0,0
sprpriority = 0+(var(0)>0)*1

[State 0, vel]
type = changeanim
trigger1 = var(8)
value = 44
elem = 6

[State 0, vel]
type = changeanim
trigger1 = !time
value = ifelse(anim>10000,10047,47)

[State 0, vel]
type = velset
trigger1 = !time
y = 0

[State 0, pos]
type = posset
trigger1 = !time
y = 0

[State 0, turn]
type = turn
trigger1 = !time
trigger1 = p2dist x < 0

[State 0, snd]
type = playsnd
trigger1 = !time
value = 0,17

[State 0, ctrl]
type = ctrlset
trigger1 = !var(8)
trigger1 = time >= 1
value = 1

[State 0, end]
type = changestate
trigger1 = !var(8)
trigger1 = !animtime
value = 0
ctrl = 1

;------------------------------------------------------------------------------------------
;Run
[Statedef 100]
type    = S
movetype = I
physics = N
ctrl = 0
anim = 100+var(13)
velset = 0,0
sprpriority = 0+(var(0)>0)*1

[State 0, pos]
type = posset
trigger1 = !time
y = 0

[State 0, vel]
type = velset
trigger1 = !var(13)
trigger1 = time = 1
x = 7.5

[State 0, vel]
type = velset
trigger1 = var(13)
trigger1 = time = 1
x = 5.5

[State 0, vel]
type = velmul
trigger1 = anim = 100
trigger1 = time >= 10
x = .95

[State 0, vel]
type = velmul
trigger1 = anim = 100
trigger1 = time >= 20
x = .8

[State 10000, PlayerPush]
type = varset
trigger1 = !time
var(20) = 0
[State 10000, PlayerPush]
type = varadd
triggerall = anim = 100
trigger1 = time >= 15
var(20) = 1

[State 100, 2]
type = AssertSpecial
trigger1 = !Ctrl
flag = NoWalk
flag2 = NoAutoTurn

[State 0, end]
type = changestate
trigger1 = !var(59)
trigger1 = command = "holdup"
value = 40

[State 0, anim]
type = changeanim
triggerall = !var(59)
triggerall = anim = 100
trigger1 = time = 25
trigger2 = time > 9
trigger2 = command != "holdfwd" || command = "holdback"
value = 101

[State 0, anim]
type = changeanim
triggerall = !var(59)
triggerall = anim = 10100
trigger1 = time > 9
trigger1 = command != "holdfwd" || command = "holdback"
value = 10101

[State 0, vel]
type = ctrlset
trigger1 = anim = 101 || anim = 10101
value = 1

[State 0, vel]
type = velset
trigger1 = anim = 101 || anim = 10101
x = 0

[State 0, end]
type = changestate
triggerall = anim = 101 || anim = 10101
trigger1 = !animtime
value = 0
ctrl = 1

;------------------------------------------------------------------------------------------
;Back Run
[Statedef 105]
type    = S
movetype = I
physics = N
anim = 105+var(13)
velset = 0,0
ctrl = 0
sprpriority = 0+(var(0)>0)*1

[State 0, pos]
type = posset
trigger1 = !time
y = 0

[State 0, vel]
type = velset
trigger1 = anim = 105
trigger1 = time = 1
x = const(velocity.run.back.x)

[State 0, vel]
type = velset
trigger1 = anim = 10105
trigger1 = time = 1
x = -5.5

[State 0, vel]
type = velmul
trigger1 = anim = 10105
trigger1 = time >= 10
x = .95

[State 0, vel]
type = velmul
trigger1 = anim = 10105
trigger1 = time >= 20
x = .6

[State 100, 2]
type = AssertSpecial
trigger1 = !Ctrl
flag = NoWalk
flag2 = NoAutoTurn

[State 0, end]
type = changestate
trigger1 = command = "holdup"
value = 40

[State 0, anim]
type = changeanim
triggerall = !var(59)
triggerall = anim = 105
trigger1 = time > 10
trigger1 = command = "holdfwd" || command != "holdback"
trigger2 = !var(0) && time >= 180
trigger3 = var(0) && time >= 180
value = 106

[State 0, anim]
type = changeanim
triggerall = !var(59)
triggerall = anim = 10105
trigger1 = time = 25
trigger2 = time > 9
trigger2 = command = "holdfwd" || command != "holdback"
value = 10106

[State 0, vel]
type = ctrlset
trigger1 = anim = 106 || anim = 10106
value = 1

[State 0, vel]
type = velset
trigger1 = anim = 106 || anim = 10106
x = 0

[State 0, end]
type = changestate
triggerall = anim = 106 || anim = 10106
trigger1 = !animtime
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = statetype != A
value = 120 + (statetype = C) 

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

