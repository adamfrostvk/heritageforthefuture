trigger1 = !helper(10000),hitshakeover
x = 1*ifelse(time%2=0,-1,1)

[State 0, state]
type = statetypeset
trigger1 = !time
trigger1 = helper(10000),GetHitVar(yvel) != 0 && helper(10000),GetHitVar(fall)
trigger2 = pos y != 0
statetype = A

[State 0, hfs]
