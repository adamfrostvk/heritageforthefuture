trigger1 = !time
value = helper(10000),GetHitVar(fall)

[State 0, end]
type = changestate
triggerall = alive
trigger1 = helper(10000),HitShakeOver
trigger1 = helper(10000),GetHitVar(yvel) = 0 && !helper(10000),GetHitVar(fall)
value = 15001

[State 0, end]
type = changestate
trigger1 = helper(10000),HitShakeOver
value = 15030

[State 0, ffb L]
