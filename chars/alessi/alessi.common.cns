physics = U ;Leave physics unchanged
ctrl = 1

[State 140, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = statetype != A
value = 140 + (statetype = C) 

[State 140, 2]
type = StateTypeSet
