ignorehitpause = 1

[State 0, anim]
type = changeanim
trigger1 = !time
value = 5210+var(13)

[State 0, pos]
type = posfreeze
trigger1 = !time
value = 4

[State 0, turn]
type = turn
trigger1 = !time
trigger1 = p2dist x < -20

[State 5210, 2] ;Go fwd
type = VelSet
triggerall = Time = 1
trigger1 = !var(59)
trigger1 = Command = "holdfwd"
x = 5
y = -8.5

[State 5210, 2] ;Go back
type = VelSet
triggerall = Time = 1
trigger1 = !var(59)
trigger1 = Command = "holdback"
x = -5
y = -8.5

[State 5210, 2] ;Go down
type = VelSet
triggerall = Time = 1
trigger1 = !var(59)
trigger1 = Command = "holddown"
trigger1 = Command != "holdfwd"
trigger1 = Command != "holdback"
x = 0
y = 0

[State 5210, 2] ;Go up
type = VelSet
triggerall = Time = 1
trigger1 = !var(59)
trigger1 = Command != "holddown"
trigger1 = Command != "holdfwd"
trigger1 = Command != "holdback"
x = 0
y = -9.5

[State 0, anim]
type = changeanim
trigger1 = time = 1
trigger1 = vel y = 0
value = 5211+var(13)

[State 0, nhb]
type = nothitby
trigger1 = !time
value = SCA
time = 15

[State 0, ctrl]
type = ctrlset
trigger1 = time = 10
value = 1

[State 4030, Gravity]
type = VelAdd
trigger1 = 1
y = .6

[State 0, end]
type = changestate
trigger1 = vel y > 0
trigger1 = pos y >= 0
value = 52
ctrl = 1

;---------------------------------------------------------------------------
; Continue?
[Statedef 5500]
type = S
ctrl = 0
anim = 5300
velset = 0,0

[State 5500, 1] ;Use continue animation if available
type = ChangeAnim
trigger1 = time = 0
trigger1 = SelfAnimExist(5500)
value = 5500


;---------------------------------------------------------------------------
;Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 0, var] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 0, var] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 0, end] ;Intro for round 1
type = changestate
trigger1 = roundno = 1
trigger2 = roundsexisted = 0
trigger2 = teammode = Turns
trigger2 = roundno > 0
value = 190


