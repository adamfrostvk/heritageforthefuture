trigger1 = anim = 5000
trigger2 = anim = 5010
waveform = square
time = 6
persistent = 0

[State 0, ffb M]
type = forcefeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
waveform = square
time = 8
ampl = 110,-1,-.3
persistent = 0

[State 0, ffb H]
