;子供化移行時サイズ
[State 20, 4]
type = modifyexplod
trigger1 = numtarget
trigger1 = target,stateno = 200003
trigger1 = (target,time = [0,9])
scale = (.4+(target,time*.08))*.833,(.4+(target,time*.08))*1.07
id = 30000

[State 20, 4]
type = modifyexplod
trigger1 = numtarget
trigger1 = target,stateno = 200003
trigger1 = (target,time = [10,13])
scale = 1.12*.833,1.12*1.07
id = 30000

[State 20, 4]
type = modifyexplod
trigger1 = numtarget
trigger1 = target,stateno = 200003
trigger1 = (target,time = [14,18])
scale = (1.12-((target,time-13)*.08))*.833,(1.12-((target,time-13)*.08))*1.07
id = 30000

;●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●
;子供化復帰時サイズ
[State 20, 4]
type = modifyexplod
trigger1 = numtarget
trigger1 = target,stateno = 200060
trigger1 = (target,Time >= 5)
scale = (1-((target,time-6)*.02))*.833,(1-((target,time-6)*.02))*1.07
id = 30000

[State 20, 4]
type = modifyexplod
trigger1 = numtarget
trigger1 = target,stateno = 200060
trigger1 = target,Time >= 5
trigger1 = !(target,time%7)
scale = (1-((target,time-6)*.02)+((target,time-6)*.03))*.833,(1-((target,time-6)*.02)+((target,time-6)*.03))*1.07
id = 30000

[State 20, 4]
type = modifyexplod
trigger1 = numtarget
trigger1 = target,stateno = 200061
scale = (.5+(target,time*.12))*.833,(.5+(target,time*.12))*1.07
id = 30000

[State 19900, VarSet(15)]
type = modifyexplod
trigger1 = numtarget
trigger1 = target,time <= 4
trigger1 = target,stateno = 200062
scale = (1.3-(target,time*.06))*.833,(1.3-(target,time*.06))*1.07
id = 30000

