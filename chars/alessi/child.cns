postype = p1
ownpal = 1
bindtime = -1
removetime=-1
pausemovetime = -1
supermove = 1
ignorehitpause = 1
scale = .833,1.07

[State -2, クリップボード]
type     = DisplayToClipBoard
trigger1 = numtarget
text     = "Explod=%d,facing=%d,facing2=%d,var(0)=%d"
params   = numexplod,facing,(target,facing),var(0)
IgnoreHitPause = 1

;●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●
[state a];打撃防御;　　← 実際に当身を出す式
type = reversaldef
trigger1 = time = 0
reversal.attr = C,HP
pausetime = 0,0
sparkno = s-1
sparkxy = 0,0
hitsound = s-1,0
numhits = 0
HitOnce = 1

[state a];　　　　　　　← 相手が動いている時にヘルパーの位置を修正する式
type = null;posset
trigger1 = time >= 1
x = floor(enemy(0), pos x)
y = floor(enemy(0), pos y)

[state a];　　　　　　　← 相手が動いている時にヘルパーの位置を修正する式
type = posset
trigger1 = time >= 1
x = floor(playerID(root,var(14)), pos x)
y = floor(playerID(root,var(14)), pos y)

[state a]
type = playsnd
trigger1 = numtarget
trigger1 = target,stateno = 200002
value = 2,2
persistent = 0

;攻撃終了
[state a]
type = targetstate
trigger1 = numtarget
trigger1 = target,alive
trigger1 = (target,stateno=[200200,200620]) && target,numexplod(815778369)
value = 200000+(target,statetype=C)*11

;喰らい誘導
[state a]
type = null;targetstate
trigger1 = numtarget
trigger1 = target,alive
trigger1 = (target,stateno!=[200000,205151]) && target,time=0
value = 205000

;カウント
[State 20, 4]
type = varadd
triggerall = numtarget
triggerall = numhelper(20032)
triggerall = !helper(20032),var(9)
trigger1 = (target,stateno = [200000,205101])
trigger1 = !(target,stateno = [200001,200004])
var(0) = 1

;戻す
[state a]
type = targetstate
triggerall = numtarget
triggerall = target,alive
triggerall = (target,stateno = [200000,200040]) || (target,stateno = [200200,200420]) || (target,stateno = [201200,201420])
triggerall = !(target,stateno = [200001,200004])
trigger1 = var(0) >= 150
trigger2 = roundstate != 2
value = 200060

[State 20, 4]
type = varset
trigger1 = 1
var(1) = 0

[State 20, 4]
type = varset
triggerall = numtarget
trigger1 = target,movetype = H
trigger1 = !target,hitshakeover
var(1) = 1

;子供化時
[State -2, CornerPush]
type = parentvarset
triggerall = numtarget
triggerall = !parent,IsHelper
triggerall = target,movetype = H
trigger1 = target,BackEdgeBodyDist <= 5 || target,FrontEdgeBodyDist <= 5
fvar(22) = 1
[State -2, CornerPush]
type = parentvarset
triggerall = numtarget
triggerall = parent,IsHelper
triggerall = target,movetype = H
trigger1 = target,BackEdgeBodyDist <= 5 || target,FrontEdgeBodyDist <= 5
fvar(24) = 1

[State -2, CornerPush]
type = parentVarSet
triggerall = numtarget
triggerall = parent,IsHelper
triggerall = target,movetype = H
trigger1 = target,statetype = A && target,stateno != [5070,5071]
trigger1 = target,stateno != 895
fvar(24) = 0

[state a]
type = hitadd;　　　　　　← ヒット数がバグるので強制的にhit数を0にしておく
trigger1 = roundstate = 2
trigger1 = numtarget
trigger1 = target,movetype != H
value = -1

[State 20, 4]
type = removeexplod
triggerall = numtarget
trigger1 = target,stateno = 200063
trigger2 = !target,alive
id = 30000

;死亡
[state a]
type = targetstate
trigger1 = numtarget
trigger1 = target,stateno = 5081
trigger1 = !target,alive
value = 205001
ctrl = 0

[state a]
Type = DestroySelf;　　　　　← ヘルパーが消える、つまり毒が消える条件式
triggerall = numtarget
trigger1 = target,stateno = 200063
trigger2 = !target,alive

[State -2, クリップボード]
type     = DisplayToClipBoard
trigger1 = 1
text     = "numtarget=%d"
