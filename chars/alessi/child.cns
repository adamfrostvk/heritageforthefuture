;子供化移行3
[Statedef 200004]
type = A
movetype = H
physics = N
ctrl = 0
poweradd = 0
sprpriority = 0

[State 0, pos]
type = nothitby
trigger1 = 1
value = SCA

[State 0, pos];未対応orホル
type = changeanim2
trigger1 = !time
value = 30500

[State 0, pos];対応済みキャラ
type = changeanim
trigger1 = !time
trigger1 = numhelper(815778369)
trigger1 = selfanimexist(26500)
value = 26500

[State 0, assert]
type = assertspecial
trigger1 = anim != 26500
flag = invisible
ignorehitpause = 1

[State 0, assert]
type = assertspecial
trigger1 = anim != 26500
flag = invisible
ignorehitpause = 1

[State 0, pos]
type = posset
trigger1 = !time
trigger1 = pos y > 0
y = 0

[State 0, vel]
type = velset
trigger1 = !time
x = -2
y = -8

[State 0, vel]
type = veladd
trigger1 = 1
y = .4

[State 0, end]
type = changestate
trigger1 = pos y >= 0 && vel y > 0
value = 205150

;---------------------------------------------------------------------------
;(HELPER)攻撃用ヘルパー・Ⅰ;@
[Statedef 1160];　　← 相手の攻撃を当身するヘルパーの式、自分で作ること
type = A
ctrl = 0
anim = 1160;　　　　← 相手が攻撃する位置と同じ位置に当身判定を出す
velset = 0,0
movetype = A
physics = N
sprpriority = 5

;向き合わせ
[State 20, 4]
type = removeexplod
triggerall = numtarget
trigger1 = facing != target,facing
id = 30000

[State 20, 4]
type = turn
triggerall = numtarget
trigger1 = facing != target,facing

[State 20, 4]
type = attackdist
trigger1 = 1
value = 0

