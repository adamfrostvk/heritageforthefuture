; HITG_SHAKE
[Statedef 205000]
type    = S
movetype= H
physics = N
velset = 0,0

[state 20000]
type = selfstate
trigger1 = (!alive || gethitvar(damage)>=Life)
value = 5020

[State 0, pos];未対応orホル
type = changeanim2
trigger1 = 1
value = 30500
ignorehitpause=1

[State 0, pos];対応済みキャラ
type = changeanim
trigger1 = numhelper(815778369)
trigger1 = selfanimexist(26500)
value = 26500

[State 0, assert]
type = assertspecial
trigger1 = anim != 26500
flag = invisible
ignorehitpause = 1

[State 5000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 205001 ;HITG_SLIDE

[State 5000, 7]
type = ChangeState
trigger1 = HitShakeOver
value = 205030

[State 5000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

[State 0, nhb]
type = nothitby
trigger1 = 1
value = ,AT

[State 10000, HitOverRide] 
type = HitOverRide
trigger1 = 1
slot = 0
stateno = -1
attr = SCA,NA,SA,HA,NP,SP,HP
time = 1

