;---------------------------------------------------------------------------
;子供化移行
[Statedef 200001]
type = S
movetype = H
physics = N
ctrl = 0
poweradd = 20
sprpriority = 0
velset = 0,0

[State 0, pos]
type = nothitby
trigger1 = 1
value = SCA

[State 0, pos]
type = changeanim2
trigger1 = !time
value = 100000

[State 0, pos]
type = changeanim2
trigger1 = !time
value = 100000

[State 4211]
type = HitDef
trigger1 = time = 0
attr = C,HT,HP;　　　　 ← タッグ判別用に攻撃属性を二種付与しておく
animtype = light
damage = 0
priority = 1, Hit
getpower = 0,0
givepower = 0,0
hitflag = F-;　　　　　← 普通には当たらないようにしておく
guardflag = N
pausetime = 0,0
sparkno = s-1
sparkxy = 0,0
hitsound = s-1,0
guardsound = s-1,0
guard.sparkno = s-1
ground.type = high
ground.slidetime = 0
ground.hittime = 9
ground.velocity = 0
guard.velocity = 0
air.velocity = 0,0
ID = 9999
nochainID = 9999
palfx.time =32
palfx.mul = 100,120,80
palfx.sinadd = 93,115,68,16
palfx.add = -30,-20,-50
air.fall = 1
fall.recover = 0
air.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0

[State 0, end]
type = changestate
trigger1 = time = 11
value = 200002

;---------------------------------------------------------------------------
;子供化移行2
[Statedef 200002]
type = S
movetype = H
physics = N
ctrl = 0
poweradd = 0
sprpriority = 0
velset = 0,0

[State 0, pos]
type = nothitby
trigger1 = 1
value = SCA

[State 18998, PalFX]
type = PalFX
trigger1 = 1
time = 1
add = 140,140,140

[State 0, pos]
type = angledraw
trigger1 = 1
scale = 1-(time*.03),1-(time*.03)

[State 0, pos]
type = angledraw
trigger1 = !(time%5)
scale = 1-(time*.03)+(time*.06),1-(time*.03)+(time*.06)

[State 0, end]
type = changestate
trigger1 = time = 20
value = 200003

;---------------------------------------------------------------------------
;子供化移行3
[Statedef 200003]
type = S
movetype = H
physics = N
ctrl = 0
poweradd = 0
sprpriority = 0
velset = 0,0

[State 0, pos]
type = nothitby
trigger1 = 1
value = SCA

[State 0, pos];未対応orホル
type = changeanim2
trigger1 = !time
value = 30500

[State 0, pos];対応済みキャラ
type = changeanim
trigger1 = !time
trigger1 = numhelper(815778369)
trigger1 = selfanimexist(26500)
value = 26500

[State 0, assert]
type = assertspecial
trigger1 = anim != 26500
flag = invisible
ignorehitpause = 1

[State 0, assert]
type = assertspecial
trigger1 = anim != 26500
flag = invisible
ignorehitpause = 1

[State 18998, PalFX]
type = PalFX
trigger1 = 1
time = 1
add = 140,140,140

[State 0, pos]
type = angledraw
trigger1 = (time = [0,8])
scale = .4+(time*.08),.4+(time*.08)

[State 0, pos]
type = angledraw
trigger1 = (time = [9,12])
scale = 1.04,1.04

[State 0, pos]
type = angledraw
trigger1 = (time = [13,17])
scale = 1.04-((time-13)*.08),1.04-((time-13)*.08)

[State 0, end]
type = changestate
trigger1 = time = 15
value = 200004

