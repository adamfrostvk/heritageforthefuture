;---------------------------------------------------------------------------
;Son弱(本体)
[Statedef 10200]
type = S
movetype = A
physics = N
ctrl = 0
velset = 0,0
anim = 2200+(var(13)>0)
poweradd = 30*(!var(13))
sprpriority = 0
facep2 = 1-(prevstateno=[100,119])

[State 10000, PlayerPush]
type = attackdist
trigger1 = 1
value = 145+ceil((fvar(10)-1)*46)

[State 10000, PlayerPush]
type = changeanim
trigger1 = var(8)
value = anim
elem = animelemno(-1)

[State 0, end]
type = changestate
trigger1 = !animtime
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;SonD弱(本体)
[Statedef 10201]
type = S
movetype = A
physics = N
ctrl = 0
;anim = 2201+(var(13)>0)
poweradd = 20*(!var(13))
sprpriority = 0
facep2 = 1-(prevstateno=[100,119])

[State 10000, PlayerPush]
type = attackdist
trigger1 = 1
value = 145

[State 10000, PlayerPush]
type = varset
trigger1 = !time
trigger1 = prevstateno = 105
var(20) = 0
[State 10000, PlayerPush]
type = varadd
trigger1 = !var(8)
var(20) = 1

[State 10000, PlayerPush]
type = velmul
trigger1 = time >= 10
trigger1 = !var(8)
x = .9

[State 10000, PlayerPush]
type = posfreeze
trigger1 = var(8) > 0

[State 10000, PlayerPush]
type = changeanim
trigger1 = var(8)
value = anim
elem = animelemno(-1)

[State 0, end]
type = changestate
triggerall = helper(10000),animelemtime(7) >= 0
trigger1 = var(20) >= 29
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Son弱(スタンド)
[Statedef 20200]
type = S
movetype = A
physics = N
ctrl = 0
anim = 20200
poweradd = 0
sprpriority = 2
velset = 0,0

[State 0, turn]
type = turn
trigger1 = facing != root,facing

[State 10000, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 0

[State 0, assert]
type = assertspecial
trigger1 = 1
flag = Noshadow
ignorehitpause = 1

[State 0, nhb]
type = nothitby
trigger1 = 1
value = ,AT

[State 10000, HitOverRide] 
type = HitOverRide
trigger1 = 1
slot = 0
stateno = 9500
attr = SCA,NA,SA,HA,NP,SP,HP
time = -1

[State 0, end]
type = changestate
trigger1 = root,movetype = H
value = 9505

[State 0, btr]
type = bindtoroot
trigger1 = 1
pos = 35+((root,fvar(10)-1)*65),-2

[State 0, btr]
type = bindtoroot
trigger1 = root,stateno = 10201
pos = 35,-2

[State 0, snd]
type = playsnd
trigger1 = !var(8)
trigger1 = animelem = 2
value = 0,10

[State 0, hit]
type = hitdef
triggerall = root,stateno = 10200
triggerall = !var(8)
triggerall = !movecontact && !movereversed
trigger1 = animelem = 4
trigger2 = animelem = 5
attr = S, NA
damage = ceil(ifelse((42*root,fvar(0))<7,7,(42*root,fvar(0)))),ceil(ifelse((42*root,fvar(0)*.25)<7,7,(42*root,fvar(0)*.25)))
priority = 5,Hit
hitflag = MAF
guardflag = M
animtype = light
air.animtype = Back
fall.animtype = Back
pausetime = 0,8
sparkno = s6000
sparkxy = -8,-45
guard.sparkno = s6010
hitsound = -1
guardsound = -1
getpower = 0,0
givepower = 20,0
ground.type = High
ground.slidetime = 13
ground.hittime = 13
ground.velocity = -6
guard.velocity = -5.5
air.velocity = -4,-4*(1.0-ifelse(root,var(40)>0,root,var(40)*.125,0))*(root,var(40)<=7)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
fall = 0
air.fall = 1
guard.kill = 0
sprpriority = 2
id = 20200
p2facing = 1

[State 0, hit]
type = hitdef
triggerall = root,stateno = 10201
triggerall = !var(8)
triggerall = !movecontact && !movereversed
trigger1 = animelem = 4
trigger2 = animelem = 5
attr = S, NA
damage = ceil(ifelse((42*root,fvar(0))<7,7,(42*root,fvar(0)))),ceil(ifelse((42*root,fvar(0)*.25)<7,7,(42*root,fvar(0)*.25)))
priority = 5,Hit
hitflag = MAF
guardflag = M
animtype = light
air.animtype = Back
fall.animtype = Back
pausetime = 0,9
sparkno = s6000
sparkxy = -8,-45
guard.sparkno = s6010
hitsound = -1
guardsound = -1
getpower = 0,0
givepower = 20,0
ground.type = High
ground.slidetime = 18
ground.hittime = 18
ground.velocity = -6
guard.velocity = -5.5
air.velocity = -4,-4*(1.0-ifelse(root,var(40)>0,root,var(40)*.125,0))*(root,var(40)<=7)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
fall = 0
air.fall = 1
guard.kill = 0
sprpriority = 2
id = 20200
p2facing = 1

;ヒット音
[State 0, snd]
type = playsnd
trigger1 = movecontact = 1
value = 0,1+(moveguarded=1)*8
ignorehitpause = 1
channel = 2

[State 0, var]
type = varset
trigger1 = movehit = 1
var(50) = 1

[State 220, CornerPush]
type = ParentVarSet
trigger1 = movecontact = 1
fvar(20) = 8.3
ignorehitpause = 1

[State 220, CornerPush]
type = VarSet
trigger1 = movecontact = 1
fvar(3) = 8.3
ignorehitpause = 1

[State 220, CornerPush]
type = parentVarSet
trigger1 = movecontact = 1
var(8) = 9+(root,stateno = 10201)
ignorehitpause = 1

[State 220, CornerPush]
type = VarSet
trigger1 = movecontact = 1
var(8) = 8+(root,stateno = 10201)
ignorehitpause = 1

[State 0, anim]
type = changeanim
trigger1 = var(8) > 0
value = anim
elem = animelemno(-1)

[State 0, pos]
type = posfreeze
trigger1 = var(8) > 0

[State 0, var]
type = varadd
trigger1 = var(8)
var(8) = -1
ignorehitpause = 1

[State -2, Combo]
type = VarSet
triggerall = IsHelper
trigger1 = !var(8)
var(43) = 0
ignorehitpause = 1

;子供化時コーナープッシュ処理
[State -2, CornerPush]
type = parentVarSet
triggerall = root,var(13)
triggerall = IsHelper
trigger1 = fvar(24)
fvar(22) = 1

[State -2, CornerPush]
type = VarSet
triggerall = root,var(13)
trigger1 = fvar(24)
fvar(24) = 0

;コーナープッシュ処理
[State -2, CornerPush]
type = VarSet
triggerall = IsHelper
trigger1 = !fvar(3)
fvar(5) = 0

[State -2, CornerPush]
type = parentVarSet
triggerall = IsHelper
trigger1 = numtarget
trigger1 = target,BackEdgeBodyDist <= 5 || target,FrontEdgeBodyDist <= 5
fvar(22) = 1

[State -2, CornerPush]
type = parentVarSet
triggerall = IsHelper
trigger1 = numhelper(1160)
trigger1 = helper(1160),numtarget
trigger1 = helper(1160),BackEdgeBodyDist <= 5 || helper(1160),FrontEdgeBodyDist <= 5
trigger2 = numhelper(1161)
trigger2 = helper(1161),numtarget
trigger2 = helper(1161),BackEdgeBodyDist <= 5 || helper(1161),FrontEdgeBodyDist <= 5
fvar(5) = 1

[State -2, CornerPush]
type = VarSet
triggerall = IsHelper
trigger1 = numtarget
trigger1 = target,BackEdgeBodyDist <= 5 || target,FrontEdgeBodyDist <= 5
fvar(5) = 1

[State -2, CornerPush]
type = VarSet
triggerall = IsHelper
trigger1 = numtarget
trigger1 = target,BackEdgeBodyDist <= 5 || target,FrontEdgeBodyDist <= 5
fvar(5) = 1

[State -2, CornerPush]
type = ParentVarSet
trigger1 = IsHelper
trigger1 = movecontact = 1
trigger1 = time > 1
fvar(3) = 0
ignorehitpause = 1

[State -2, CornerPush]
type = parentVarSet
triggerall = IsHelper
trigger1 = root,fvar(20) = [0,.1]
trigger2 = NumTarget
trigger2 = target,statetype = A && target,stateno != [5070,5071]
fvar(20) = 0

[State -2, CornerPush]
type = VarSet
triggerall = IsHelper
trigger1 = fvar(3) = [0,.1]
trigger2 = NumTarget
trigger2 = target,statetype = A && target,stateno != [5070,5071]
trigger3 = root,fvar(3)
fvar(3) = 0

[State -2, CornerPush]
type = PosAdd
triggerall = IsHelper
triggerall = fvar(3)
triggerall = fvar(5)
triggerall = !numhelper(7000) && !numhelper(8000) && !root,numhelper(7000) && !root,NumHelper(8000)
trigger1 = !numtarget
trigger2 = numtarget
trigger2 = !target,gethitvar(hitshaketime)
x = -fvar(3)

[State -2, CornerPush]
type = VarSet
triggerall = IsHelper
triggerall = fvar(3)
triggerall = !numhelper(7000) && !numhelper(8000) && !root,numhelper(7000) && !root,NumHelper(8000)
trigger1 = !numtarget
trigger2 = numtarget
trigger2 = !target,gethitvar(hitshaketime)
fvar(3) = fvar(3)*.75

[State 0, power]
type = poweradd
trigger1 = var(50)
value = 40*(!root,var(13))

[State 0, var]
type = varset
trigger1 = 1
var(50) = 0

[state -2, var]
type = parentvaradd
trigger1 = movehit = 1
var(40) = 1

[State 0, end]
type = changestate
trigger1 = !animtime
trigger2 = !(root,stateno = [10200,10201])
value = 10001

