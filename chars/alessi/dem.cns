;タンデム走り
[Statedef 3501]
type    = S
movetype= I
physics = N
juggle  = 0
velset = 0,0
ctrl = 0
sprpriority = 0

[state 3000]
type = changeanim
trigger1 = !time
trigger1 = (anim != [3500,3501])
value = 3501

[state 3000]
type = changeanim
trigger1 = var(13)
trigger1 = anim != 10100
value = 10100

[state 3000]
type = velset
trigger1 = 1
x = 10.5;*const(size.xscale)

[state 3000]
type = posset
trigger1 = !time
y = 0

[State 100, 1]
type = Varadd
trigger1 = fvar(2) >= 0
fv = 2
value = -1

[State -1,0 ];近弱
type = ChangeState
value = 3700+(var(13)>0)*3
trigger1 = command = "x"
trigger1 = command != "holddown"
trigger1 = (p2bodydist x = [-5,30])

[State -1,0 ];近中
type = ChangeState
value = 3701+(var(13)>0)*3
trigger1 = command = "y"
trigger1 = command != "holddown"
trigger1 = (p2bodydist x = [-5,30])

[State -1,0 ];近強
type = ChangeState
value = 3702+(var(13)>0)*3
trigger1 = command = "z"
trigger1 = command != "holddown"
trigger1 = (p2bodydist x = [-5,40])

[State -1,0 ];ガキ近屈攻撃
type = ChangeState
value = 3903
triggerall = var(13)
trigger1 = command = "x" || command = "y" || command = "z" || command = "b"
trigger1 = command = "holddown"
trigger1 = (p2bodydist x = [-5,40])

[State -1,0 ];近屈弱
type = ChangeState
value = 3900
trigger1 = command = "x" || command = "b"
trigger1 = command = "holddown"
trigger1 = (p2bodydist x = [-5,40])

[State -1,0 ];近屈中
type = ChangeState
value = 3901
trigger1 = command = "y"
trigger1 = command = "holddown" || command = "holdfwd"
trigger1 = (p2bodydist x = [-5,40])

[State -1,0 ];6中
type = ChangeState
value = 3603
trigger1 = command = "y"
trigger1 = command = "holdfwd" && command != "holddown"

[State -1,0 ];弱
type = ChangeState
value = 3600
trigger1 = command = "x"
trigger1 = command != "holddown"

[State -1,0 ];中
type = ChangeState
value = 3601
trigger1 = command = "y"
trigger1 = command != "holddown"

[State -1,0 ];強
type = ChangeState
value = 3602
trigger1 = command = "z"
trigger1 = command != "holddown"

[State -1,0 ];屈弱
type = ChangeState
value = 3800
trigger1 = command = "x" || command = "b"
trigger1 = command = "holddown"

[State -1,0 ];屈中
type = ChangeState
value = 3801
trigger1 = command = "y"
trigger1 = command = "holddown"

[State -1,0 ];屈強
type = ChangeState
value = 3802
trigger1 = command = "z"
trigger1 = command = "holddown"

[state 3000]
type = velset
trigger1 = time >= 1
trigger1 = fvar(2) <= 0
x = 0

[state -2, var]
