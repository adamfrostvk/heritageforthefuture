;コーナープッシュ処理
[State -2, CornerPush]
type = VarSet
triggerall = IsHelper
trigger1 = !fvar(3)
fvar(5) = 0

[State -2, CornerPush]
type = parentVarSet
triggerall = IsHelper
trigger1 = numtarget
trigger1 = target,BackEdgeBodyDist <= 5 || target,FrontEdgeBodyDist <= 5
fvar(22) = 1

[State -2, CornerPush]
type = parentVarSet
triggerall = IsHelper
trigger1 = numhelper(1160)
trigger1 = helper(1160),numtarget
