trigger1 = power < 1000
value = 1000

[State 0, end]
type = changestate
triggerall = enemy,authorname = "warusaki3" || enemy,authorname = "kikurage" || enemy,authorname = "Shio"
trigger1 = p2name = "dio"
trigger2 = p2name = "final dio"
trigger3 = p2name = "shadow dio"
trigger4 = p2name = "Shadow Dio"
trigger5 = p2name = "DIO BRANDO"
value = 194

[State -2, 3]
type = ChangeState
triggerall = teamside = 1
trigger1 = (P2Name = "alessi" || P4Name = "alessi") && EnemyNear,AuthorName = "Nimame"
value = 191+(random%2)

[State -2, 3]
type = ChangeState
triggerall = teamside = 2
trigger1 = (P2Name = "alessi" || P4Name = "alessi") && EnemyNear,AuthorName = "Nimame"
value = 191+(P2stateno=191)

[State 0, end]
type = changestate
trigger1 = 1
value = 191+(random%3)

