;---------------------------------------------------------------------------
;Stand
[Statedef 0]
type = S
movetype = I
physics = S
velset = 0,0
sprpriority = 0

[State 0, anim]
type = changeanim
;triggerall = !(prevstateno = [10,12])
trigger1 = anim != (0+var(0)) && anim != (5+var(0))
trigger2 = anim = (5+var(0)) && !animtime
value = 0+var(0)

[State 0, vel]
type = velset
trigger1 = !time
y = 0

[State 0, vel]
type = posset
trigger1 = !time
y = 0

[State 0, 4]
type = ChangeAnim
triggerall = var(0)
trigger1 = Anim = 5
value = 5+var(0)

[State 0, end]
type = changestate
trigger1 = !alive
value = 5050

[State 0, end]
type = DestroySelf
trigger1 = IsHelper

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10+var(0)

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11+var(0)
sprpriority = 0

[State 0, 4]
type = ChangeAnim
triggerall = var(0)
trigger1 = Anim = 6
value = 6+var(0)

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6+var(0) && AnimTime = 0
value = 11+var(0)

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12+var(0)

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = Helper
trigger1 = var(0)
trigger1 = anim = 10020
trigger1 = numhelper(10025) = 0
helpertype = normal
ID = 10025
pos = 0, 0
postype = p1
facing = 1
stateno = 10025

[State 20, 1]
type = Helper
trigger1 = var(0)
trigger1 = anim = 10021
trigger1 = numhelper(10026) = 0
helpertype = normal
ID = 10026
pos = 0, 0
postype = p1
facing = 1
stateno = 10026

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20+var(0) && Anim != 5+var(0)
trigger2 = Anim = 5+var(0) && AnimTime = 0
value = 20+var(0)

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21+var(0) && Anim != 5+var(0)
trigger2 = Anim = 5+var(0) && AnimTime = 0
value = 21+var(0)
;---------------------------------------------------------------------------
;jump
[Statedef 40]
type    = S
physics = S
sprpriority = 0

[State 20, 4]
type = Changestate
trigger1 = !time
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))+var(0)

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3+var(0)

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
;Jump Land
[Statedef 52]
type = S
physics = S
ctrl = 0
anim = 47+var(0)
velset = 0,0

[State 0, vel]
type = velset
trigger1 = !time
y = 0

[State 0, pos]
type = posset
trigger1 = !time
y = 0

[State 0, turn]
type = turn
trigger1 = !time
trigger1 = p2dist x < 0

[State 0, snd]
type = playsnd
trigger1 = !time
value = 0,17

[State 0, ctrl]
type = ctrlset
trigger1 = ifelse(prevstateno=10215||prevstateno=11400||prevstateno=3960,time=3,time=1)
value = 1

[State 0, end]
type = changestate
trigger1 = !animtime
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = N
anim = 100+var(0)
ctrl = 0

[State 20, 0]
type = sprpriority
trigger1 = !var(0)
value = 1

[State 20, 1]
type = Helper
trigger1 = var(0)
trigger1 = anim = 10100
trigger1 = numhelper(10025) = 0
helpertype = normal
ID = 10025
pos = 0, 0
postype = p1
facing = 1
stateno = 10025

[State 220, Position]
type = PosSet
trigger1 = Time = 0
y = 0

[State 100, 1]
type = VelSet
trigger1 = time = 1
x = 8.5

[State 100, 2]
type = AssertSpecial
trigger1 = !Ctrl
flag = NoWalk
flag2 = NoAutoTurn

[State 101, 3]
type = ChangeState
triggerall = time >= 8
trigger1 = command != "holdfwd"
trigger2 = time = 30
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 105]
type    = S
physics = N
ctrl = 0
anim = 105+var(0)

[State 100, 2]
type = AssertSpecial
trigger1 = !Ctrl
flag = NoWalk
flag2 = NoAutoTurn

[State 20, 0]
type = sprpriority
trigger1 = !var(0)
value = 1

[State 20, 1]
type = Helper
trigger1 = var(0)
trigger1 = anim = 10105
trigger1 = numhelper(10026) = 0
helpertype = normal
ID = 10026
pos = 0, 0
postype = p1
facing = 1
stateno = 10026

[State 220, Position]
type = PosSet
trigger1 = Time = 0
y = 0

[State 100, 1]
type = VelSet
trigger1 = time = 1
x = -8.5

[State 101, 3]
type = ChangeState
triggerall = time >= 8
trigger1 = command != "holdback"
trigger2 = time = 30
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = statetype != A
value = 120 + (statetype = C) +var(0)

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

