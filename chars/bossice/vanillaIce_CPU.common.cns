trigger1 = anim = 5012+var(0)
trigger2 = anim = 5002+var(0)
trigger3 = anim = 5030+var(0)
trigger4 = anim = [5051+var(0),5059+var(0)]
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

