;---------------------------------------------------------------------------
; SGUARDHIT (shaking)
[Statedef 150]
type    = S
movetype = H
physics = N
velset = 0,0

[State 150, 1]
type = ChangeAnim
trigger1 = 1
value = 150+var(0)

[State 150, 2]
type = ChangeState
trigger1 = HitShakeOver
value = 151 + 2*(command = "holddown")

[State 150, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 150, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 150, 3]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 3

;---------------------------------------------------------------------------
; SGUARDHIT2 (knocked back)
[Statedef 151]
type    = S
movetype = H
physics = S
anim = 150+var(0)

[State 151, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 151, 2]
type = VelSet
trigger1 = Time = GetHitVar(slidetime)
trigger2 = HitOver
trigger3 = numhelper(715)
trigger3 = prevstateno = 710
trigger4 = numhelper(715)
trigger4 = prevstateno = 711
x = 0

[State 0, ctrl]
type = ctrlset
trigger1 = time = GetHitVar(ctrltime)
trigger1 = prevstateno != [710,711]
value = 1

[State 151, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 151, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 0, end]
type = changestate
trigger1 = HitOver
trigger1 = prevstateno != [710,711]
trigger2 = !numhelper(715)
trigger2 = prevstateno = [710,711]
value = 130
ctrl = 1

[State 0, end]
type = changestate
triggerall = numhelper(815)
trigger1 = command != "holdback"
trigger1 = prevstateno = 711
trigger2 = prevstateno = 710
trigger2 = helper(20032),var(14) + helper(20032),var(15) > helper(20032),var(13)
trigger3 = prevstateno = 710
trigger3 = helper(20032),var(14) + helper(20032),var(15) > helper(20032),var(13)
value = 711

