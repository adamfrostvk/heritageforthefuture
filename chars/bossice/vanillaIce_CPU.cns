trigger1 = 1
fvar(0) = root,fvar(2)

[State 0, pal]
type = palfx
trigger1 = root,var(9) != 2 || (root,var(9) = 2 && !(time%4))
trigger1 = var(1) = 8 || var(1) = 4
trigger2 = root,fvar(2) <= 20
trigger2 = !var(1) && time%4=0
time = 2
add = 128,-256,-256

