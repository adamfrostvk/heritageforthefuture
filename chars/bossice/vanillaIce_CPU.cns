[ja.Quotes]
victory1 = "これを見て　後ろを振り向いたとき\nお前らは　死ぬ"
victory2 = "こなみじんになって　死んだ"
victory3 = "ディオ様を倒そうなどと\n思い上がった考えは正さねばならん"
victory4 = "確実に追いつめて倒す……確実に……"
victory5 = "きさまはこのヴァニラ・アイスの前では無力だ…"
victory6 = "ディオ様はこの私を信頼して\n「まかせる」とおっしゃったのだ！"
victory7 = "わたしのスタンドが圧倒的に勝っているのだ"
victory8 = "わたしを怒らせたのはキサマだッ！\nキサマが悪いのだッ！"
