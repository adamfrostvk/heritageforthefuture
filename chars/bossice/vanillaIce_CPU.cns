air.type = High
air.velocity = -6,-6*(1.0-ifelse(var(40)>0,var(40)*.125,0))*(var(40)<=7)
air.hittime = 15
yaccel = .36
fall = 1
fall.recovertime = 30
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
p2facing = 1

