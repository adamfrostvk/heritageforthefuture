trigger1 = AnimTime = 0 && !(P2movetype!=H&&(P2stateno=[3025,3026])&&enemynear,name="Hol horse")
value = , NT,ST,HT
time = 1

[State 5120, 6] ;Can't be hit right after getting up (short time)
type = NotHitBy
trigger1 = AnimTime = 0 && !(P2movetype!=H&&(P2stateno=[3025,3026])&&enemynear,name="Hol horse")
value2 = SCA
time = 1

;時止め時無敵解除
[State 5120, 6] ;Can't be hit right after getting up (short time)
type = HitBy
trigger1 = ((enemynear,Time >= 111 &&P2stateno=3050)||(enemynear,Time >= 116 &&P2stateno=3060))&&enemynear,name="jotaro"
value = SCA

;時止め時無敵解除
[State 5120, 6] ;Can't be hit right after getting up (short time)
type = StatetypeSet
trigger1 = ((enemynear,Time >= 111 &&P2stateno=3050)||(enemynear,Time >= 116 &&P2stateno=3060))&&enemynear,name="jotaro"
statetype=A

[State 5120, 7]
type = SelfState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

