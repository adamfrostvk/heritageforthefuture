trigger1 = time=0
Anim = 10600
id = 10600
pos = floor(16*const(size.xscale)), floor(34*const(size.xscale))
postype = p1
bindtime = -1
removeongethit = 1
sprpriority = 2
scale = const(size.xscale),const(size.yscale)

;~~~補正かかる技ヒット判別
[state -2]
type = VarSet
trigger1 = movehit=1
var(17) = 1
ignorehitpause=1

;~~~自分側のhitpause作成~~
[state 250]
type = varset
trigger1 = time=0
var(10) = 100

[state 250]
type = varadd
trigger1 = movecontact&&var(10)>=0
var(10) = -1

[state 250]
type = varset
trigger1 = movecontact=1
var(10) = 9

[state 250]
type = varset
trigger1 = movecontact&&((enemynear,prevstateno=[5000,5099])||(enemynear,prevstateno=[150,155]))&&P2movetype!=H&&var(10)>0
var(10) = 0

[state 250]
type = ChangeAnim
trigger1 = movecontact && var(10)>var(8) && var(10)>0
value = anim
elem = ifelse(AnimElemNo(0)=var(7),AnimElemNo(0),AnimElemNo(-1))

[state 250]
type = varset
trigger1 = var(10)<=0||!movecontact
var(7) = AnimElemNo(0)

[state 250]
type = varset
trigger1 = var(10)<=0||!movecontact
var(8) = AnimElemTime(AnimElemNo(0))
;~~~~~~~~~~~~~~~~~~~~~~~~~

;~~~相手側のhitpause作成~~
[state 250]
type = varset
trigger1 = time=0
fvar(9) = 100

[state 250]
type = varset
trigger1 = movecontact=1
fvar(9) = 9

[state 250]
type = varadd
trigger1 = movecontact&&fvar(9)>=0
fvar(9) = -1

[state 250]
type = varset
trigger1 = movecontact&&((enemynear,prevstateno=[5000,5099])||(enemynear,prevstateno=[150,155]))&&P2movetype!=H&&fvar(9)>0
fvar(9) = 0
;~~~~~~~~~~~~~~~~~~~~~~

[State 0, HitDef]
type = HitDef
triggerall = (var(10)<=0||!movecontact) && roundstate<3
trigger1 = AnimElem=2
attr = A,NA        ;SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
hitflag = MAF        ;HLAFD+-
guardflag = MA         ;HLA
getpower = 4*ifelse(Power%5<3,10,9),0
givepower = 2*ifelse(Power%5<3,10,9),0
animtype = light          ;light,medium,hard,back,up,diagup
air.animtype = back
;fall.animtype = Back
damage = ifelse(floor(3*fvar(7))<1,1,floor(3*fvar(7)))*7
pausetime = 1,9
sparkno = -1
guard.sparkno = -1
sparkxy = ifelse((Abs(P2bodydist X)-10)<20,-20,-10),ceil(-36*const(size.yscale))
hitsound = -1;s1,0
guardsound = -1;s0,0
ground.type = Low
ground.slidetime = ifelse(var(18)>=9&&random<=ifelse(var(18)=9,200,ifelse(var(18)=20,150,100)),0,11)
ground.hittime = ifelse(var(18)>=9&&random<=ifelse(var(18)=9,200,ifelse(var(18)=20,150,100)),0,11)
guard.slidetime = 11
guard.hittime = 11
air.hittime = 11
yaccel = .4
ground.velocity = -6.65*const(size.xscale)
air.velocity = -2.5,-8.0*(1.0-ifelse(var(16)>0,var(16)*.125,0))*(var(16)<=7)
airguard.velocity = -4.0,-3.0
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
fall = 0
air.fall = 0
fall.xvelocity = 0
fall.recover = 1
fall.recovertime = 16+10
air.recover = 0
p2facing=1

