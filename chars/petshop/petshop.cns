trigger1 = Vel Y>0&&Pos Y>=0
value = 15110

;相手吹き飛びダウン(Enemy Fall Down)
[statedef 3217]
type  = A
movetype= H
physics = N
ctrl = 0
velset = 0,0

[state 816]
