trigger1 = time=0
Anim = 10290
id = 10290
pos = floor((16-22)*const(size.xscale)), floor((34-6)*const(size.xscale))
postype = p1
bindtime = -1
removeongethit = 1
sprpriority = 2
scale = const(size.xscale),const(size.yscale)

[State 1000, Spark]
type = RemoveExplod
trigger1 = time=0
trigger2 = AnimElem=5
id = 10200

[State 1000, Spark]
