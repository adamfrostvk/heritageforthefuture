;Var(0):ランダム用
;Var(1):強弱判定など
;Var(2):方向判定など
;Var(3):
;Var(4):KO時やられ声
;Var(5):本体モード時のアニメ判別
;Var(6):本体モード時のアニメ周期判別
;Var(7):攻撃ヒットした瞬間のアニメ判別1
;Var(8):攻撃ヒットした瞬間のアニメ判別2
;var(9):コマンド先行入力
;var(10):自分側のhitpause作成用
;var(11):
;var(12):ダッシュ中に出したか
;var(13):ヒットしてから何F経ったか
;var(14):
;var(15):Life
;Var(16):ヒット数
;var(17):補正かかる技ヒットフラグ
;var(18):永久補正(永久補正かかってからのヒット数)
;var(19):永久補正(かかるヒット数)
;Var(20):アドバンシングガード用(使用判別)
;var(21):アドバンシングガード用(ガード時間)
;var(22):スタンドON/OFF判別(0:OFF,1:ON)
;var(23):スタンドゲージ残量(72最大,Danger残り26以下,-1:スタンドクラッシュ中)
;Var(24):小・大ジャンプ判定
;var(25):投げ抜け可能状態判定
;Var(26):FirstAttack判別
;var(27):タンデム入力・タンダム中判別
;var(28):タンデムランダム用
;var(29):KO時間判別
;var(30):ヒット数増減判別
;var(31):
;var(32):スタンド食らい処理:gethitvar(damage)
;var(33):スタンド食らい処理:gethitvar(hitshaketime)
;var(34):スタンド食らい処理:gethitvar(hittime)
;var(35):スタンド食らい処理:gethitvar(animtype)
;var(36):スタンド食らい処理:gethitvar(groundtype)
;var(37):スタンド食らい処理:gethitvar(airtype)
;var(38):スタンド食らい処理:gethitvar(fall)
;var(39):スタンド食らい処理:gethitvar(recovertime)
;var(40):ヒット音判別（弱・中・強・斬．．．）
;var(41):ヒット属性判別（弱・中・強・必殺技）
;var(42):ヒットスパークＸ座標
;Var(43):ヒットスパークＹ座標
;Var(44):AI用
;Var(45):AI用
;Var(46):AI用
;Var(47):
;var(48):音声モード判別
;var(49):音声モード変更
;var(50):
;var(51):ランダム（CPUの動き)
;var(52):ジャンプ中に食らったか
;~~~~ジョジョシステム用~~~~
;var(53):ジョジョシステム有無
;var(54):残りラウンド数
;var(55):
;var(56):
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;var(57):ゲージのON/OFF判別
;Var(58):
;var(59):モード判別(0:JOJO's Bizzare Adventure,1:JOJO's Venture)
;fvar(0):スタンド食らい処理:gethitvar(xvel)
;fVar(1):スタンド食らい処理:gethitvar(yvel)
;fVar(2):スタンド食らい処理:gethitvar(yaccel)
;fVar(3):
;fvar(4):
;fvar(5):攻撃力補正（相手体力）
;fvar(6):コンボ数によるダメージ補正
;fvar(7):補正後の攻撃力
;fvar(8):ガードされた数
;fvar(9):画面端ヒットバック用（相手のヒットポーズ時間判別）
;fvar(10):画面端ヒットバック用(ground.velocity)
;fvar(11):画面端ヒットバック用(ground.slidetime)
;fvar(12):画面端ヒットバック用(現在の速度取得)
;fvar(13):ダッシュコマンド用(Dash Command)
;fvar(14):
;fvar(15):
;fvar(16):強アイスィクルピックヒット率
;fvar(17):弱アイスィクルピック溜め用
;fvar(18):中アイスィクルピック溜め用
;fvar(19):強アイスィクルピック溜め用
;fvar(20):相手の出した技判別(相手が攻撃中か)
;fvar(21):相手の出した技判別(相手が攻撃してから判別するまでの時間)
;fvar(22):相手の出した技判別(技判別)
;fvar(23):相手のジャンプ頻度判別
;fvar(24):自分が攻めている状態か判別
;fvar(25):相手の間合い判別（最大リーチの技判別）
;fvar(26):相手のヘルパー系飛び道具出現時間判別
;fvar(27):相手の飛び道具出現時間判別
;fvar(28):AI反応速度用
;fvar(29):相手の攻撃状態判別用
;fvar(30):状態判定用時間など
;fvar(31):相手が空中にいる時間判別
;fvar(32):相手の隙判別
;fvar(33):状態判定
;fvar(34):リーチの長いキャラ判別
;fvar(35):ガードすべき状況判別
;fvar(36):跳び込みヒット判定
;fvar(37):有利時間判別
;fvar(38):AI判定
;fvar(39):システム判別(5:JOJO's Bizzare Adventure)
;---------------------------------------------------------------------

;---------------------------------------------------------------------
; 基本設定
[Data]
life = 1000          ; 体力ゲージ、上限値（デフォルト：1000）
power = 10000        ; パワーゲージ、デフォルト：1000
attack = 100         ; 攻撃力（％）
defence = 84        ; 防御力（％）
fall.defence_up = 50 ; 空中コンボ修正率（％）
liedown.time = 20    ; ダウン時間
airjuggle = 15       ; 空中コンボ制限数
sparkno = -1;0       ; デフォルトスパーク番号
guard.sparkno = -1;40; デフォルトガードスパーク番号
KO.echo = 0          ; ＫＯボイスエコー(0:OFF、1:ON)
volume = 255          ; キャラボイスボリューム値
IntPersistIndex = 53 ;次のラウンドに設定した数値以上のVarを持ち越す
FloatPersistIndex = 37;次のラウンドに設定した数値以上のfVarを持ち越す

[Size]
xscale = 1   	     ;水平サイズ倍率
yscale = 1   	     ;垂直サイズ倍率
ground.back = 17     ;キャラ幅（地上、後ろ側）
ground.front = 17    ;キャラ幅（地上、前側）
air.back = 17        ;キャラ幅（空中、後ろ側）
air.front = 17       ;キャラ幅（空中、前側）
z.width = 10         ;キャラ幅（ｚ軸）
height = 50	         ;キャラの高さ（ジャンプで飛び越せる高さ）
attack.width = 4,4   ;デフォルトアタック幅：後ろ、前
attack.dist = 120    ;ガードモーションを取る距離のデフォルト位置
proj.attack.dist = 80;Projectileのガードモーションを取る距離のデフォルト位置
proj.doscale = 0     ;Projectileにもキャラの大きさを適用させるか(0:OFF、1:ON)
head.pos = 2,-82     ;頭部座標
mid.pos = 2,-48      ;体中心部座標
shadowoffset = 0     ;キャラの影・オフセット(Z軸)値

[Velocity]
walk.fwd  = 4.15      ; 前進速度
walk.back = -3.85     ; 後退速度
run.fwd  = 8.5, 0    ; 前ダッシュ速度（y<0の場合、ホップステップ）
run.back = -7.5,0    ; バックステップ速度（y=0の場合、走り）
jump.neu = 0,-6.0      ; 垂直ジャンプ速度
jump.fwd = 2.5         ; 前方ジャンプ速度
jump.back = -2.5       ; 後方ジャンプ速度
runjump.fwd = 5.0      ; 前方ジャンプ速度（ダッシュ中）
runjump.back = -5.0    ; 後方ジャンプ速度（ダッシュ中）
airjump.neu = 0,-8.0  ; 空中垂直ジャンプ速度
airjump.fwd = 5.0    ; 空中前方ジャンプ速度
airjump.back = -5.0  ; 空中後方ジャンプ速度

[Movement]
airjump.num = 0        ; 空中ジャンプ回数
airjump.height = 35   ; 空中ジャンプ最低高度
yaccel = .25           ; キャラ重力加速度
stand.friction = .85   ; 摩擦係数（立ち状態）
crouch.friction = .82  ; 摩擦係数（しゃがみ状態）


;---------------------------------------------------------------------------

;_/_/_/_/CPU_/_/_/_/
;---------------------------------------------------------------------------
;立ち状態(ＣＰＵ)
[Statedef 3]
type    = S
physics = S
anim = 0
sprpriority = 0
velset = 0,0
ctrl =0

[State 13, 1]
type = ChangeAnim
trigger1 = P2Dist X<0
value = 5

[State 13, 1]
type = Turn
trigger1 = P2Dist X<0

;--------
[State 1000, Spark]
type = AssertSpecial
trigger1 = var(22)
flag = noshadow

[State 11, 1]
type = ChangeAnim
trigger1 = (Anim =[1,3]) && AnimTime=0
value = 0

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%64=0
value = 1

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%128=0
value = 2

[State 11, 1]
type = ChangeAnim
trigger1 = Anim = 0 && random%256=0
value = 3

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 5120 && P2Dist X>=0
value = 5

[State 11, 1] ;Change from turning animation
type = Turn
trigger1 = Anim = 5120 && P2dist X<0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 5 && var(22)
value = 5+var(22)*10000

[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != 0+var(22)*10000 && Anim != 5+var(22)*10000 && Anim!=10002)
trigger2 = Anim = 5+var(22)*10000 && AnimTime = 0 ;Turn anim over
trigger3 = Anim >= 10000 && !var(22)
value = 0+var(22)*10000

[State 1000, Spark]
type = Explod
trigger1 = (Anim=10000 && AnimElem=1)||(Anim=10002 && AnimElem=12)
Anim = 10001
id = 10001
pos = 0, 0
postype = p1
bindtime = -1
removetime = -1
removeongethit = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)
persistent=0

;スタンド出現エフェクト
[State 0, Helper]
type = Explod
trigger1 = var(22) && !numhelper(20000)
ID = 7900
anim = 7900
pos = ceil(-18*const(size.xscale)),ceil(0*const(size.yscale))
postype = p1
sprpriority = 5
facing = 1
scale = const(size.xscale),const(size.yscale)

;スタンド出現エフェクト
[State 0, Helper]
type = Explod
trigger1 = var(22) && !numhelper(20000)
ID = 7900
anim = 7901
pos = ceil(-18*const(size.xscale)),ceil(0*const(size.yscale))
postype = p1
sprpriority = -1
facing = 1
scale = const(size.xscale),const(size.yscale)

;スタンドON時の本体用ヘルパー
[State 0, Helper]
type = Helper
trigger1 = var(22) && !numhelper(20000)
helpertype = normal
name = "iggy"
ID = 20000
stateno = 20000
pos = ceil(0*const(size.xscale)),ceil(0*const(size.yscale))
postype = p1
facing = 1

[state 0]
type = varadd
trigger1 = time
var(11) = 1

[state 0]
type = varset
trigger1 = animtime=0
var(11) = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0
;-----------

[State 13, 1]
type = ChangeState
trigger1 = roundstate!=2
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;しゃがみ状態(ＣＰＵ)
