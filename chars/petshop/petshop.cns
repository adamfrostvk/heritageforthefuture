trigger2 = (P2BodyDist X>40 && time>=8)||(P2bodydist X<=40&&time>=6)
trigger2 = ((P2BodyDist X <80&&random<500) || (random<200 && P2BodyDist X =[80,120]) || (random<160 && (P2BodyDist X =[120,160])) || (random<70 && P2BodyDist X >160))
trigger3 = P2BodyDist X>40 && time>=4
trigger3 = (P2bodydist X>120&&(enemy,numproj>0||(enemy,numhelper&&inguarddist))&&random<400)
value = 13

[State 20, 4]
type = ctrlset
trigger1 = roundstate>2
value = 1
