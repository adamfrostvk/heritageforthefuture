type = VarSet
trigger1 = root,projhittime(10520)=1
var(16) = 1

;コンボ補正
[State 0, Helper]
type = ParentVarAdd
trigger1 = root,projhittime(10520)=1
var(16) = 1
persistent=0

;~~~補正かかる技ヒット判別
[state -2]
type = ParentVarSet
trigger1 = root,projhittime(10520)=1
var(17) = 1
ignorehitpause=1

[State 0, HitDef]
type = Projectile
trigger1 = !var(16)
attr = S,SA
hitflag = MAF
guardflag = MA
getpower = 4*ifelse(Power%5<3,10,9),0
givepower = 2*ifelse(Power%5<3,10,9),0
animtype = Hard
air.animtype = Hard
fall.animtype = Hard
damage = ifelse(floor(14*root,fvar(7))<1,1,floor(14*root,fvar(7)))*7,0
pausetime = 1,13
sparkno = -1
guard.sparkno = -1
sparkxy = ifelse((Abs(P2bodydist X)-10)<20,-20,-10),ceil(-30*const(size.yscale))
hitsound = -1;s1,2
guardsound = -1;s0,1
ground.type = Low
air.type = Low
ground.slidetime = ifelse(root,var(18)>=9&&random<=ifelse(root,var(18)=9,200,ifelse(root,var(18)=20,150,100)),0,18)
ground.hittime = ifelse(root,var(18)>=9&&random<=ifelse(root,var(18)=9,200,ifelse(root,var(18)=20,150,100)),0,18)
guard.slidetime = 18
guard.hittime = 18
air.hittime = 18
yaccel = .4
ground.velocity = -11.75*const(size.xscale)
guard.velocity = -11.75*const(size.xscale)
air.velocity = -3.5,-7.0*(1.0-ifelse(root,var(16)>0,root,var(16)*.125,0))*(root,var(16)<=7)
airguard.velocity = -4.0,-3.0
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
air.fall = 1
fall.xvelocity = 0
fall.yvelocity = 0
fall.recover = 1
fall.recovertime = 24+13
guard.kill = 0
ProjID = 10520
projanim = 11805
projremovetime = 1
velocity = vel x,vel y
p2facing=1

;~~~~~~~~~~~~~~~~~~~~~~~~~

;====ヒット音設定
[state 200]
type = varset
trigger1 = time=0
var(40) = 2

;====攻撃属性設定
[state 200]
type = varset
trigger1 = time=0
var(41) = 20

;====ヒットスパークＸ座標
[state 200]
type = varset
trigger1 = 1
var(42) = ifelse((Abs(P2bodydist X)-10)<20,0,-10)

;====ヒットスパークＹ座標
[state 200]
type = varset
trigger1 = 1
var(43) = ceil(-30*const(size.yscale))
;~~~~~~~~~~~~~~~~~~~~~~~~~

;□□□ヒットスパーク・サウンド等□□□
[State 0, Helper]
type = Explod
triggerall = !(ScreenPos X<=-30||ScreenPos X>=350||ScreenPos Y<=-30)
trigger1 = root,projcontacttime(10520)=1
helpertype = normal
name = "Hit_Spark"
id = 7000
anim = ifelse(root,projguardedtime(10520)=1,7000,7100+ifelse(var(41)=20,6,ifelse(var(41)=10,5,var(41)))*10)
pos = var(42),var(43)
pos = 0,0
postype = p1
ownpal = 1
ontop = 1
sprpriority = 9
scale = .8333333,1.07142857142857
pausemovetime=999
supermovetime=999
ignorehitpause =1

[state 250]
type = DestroySelf
trigger1 = ScreenPos X<=-30||ScreenPos X>=350||ScreenPos Y<=-30
trigger2 = root,movetype=H&&(root,stateno!=[150,155])&&(root,stateno!=[120,132])
trigger3 = root,projcontacttime(10520)=1

