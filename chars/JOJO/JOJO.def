[Info]
Name         = "Joseph Joestar"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "JOJO"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 04,14,2002     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002     ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "Nimame"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 4,1,2,3,5
;-----------------------------------------------------------------------------

[Files]
Cmd     = JOJO.cmd
Cns     = JOJO.cns
St      = JOJO.cns
St1      = -2,-3.cns
St2      = config.txt
StCommon = JOJO.common.cns
Sprite  = JOJO.sff
Anim    = JOJO.air
Sound   = JOJO.snd

Pal1 = act/JOJO2.act
Pal2 = act/JOJO3.act
Pal3 = act/JOJO4.act
Pal4 = act/JOJO1.act
Pal5 = act/JOJO5.act
