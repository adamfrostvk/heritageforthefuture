ground.hittime =   ifelse(root,var(18)>=9&&random<=ifelse(root,var(18)=9,200,ifelse(root,var(18)=20,150,100)),0,12)
guard.slidetime = 12
guard.hittime = 12
air.hititme = 12
yaccel = .4
ground.velocity = -6.65*const(size.xscale)
airguard.velocity = -4.0,-3.0
air.velocity = -2.5,-7.0*(1.0-ifelse(root,var(16)>0,root,var(16)*.125,0))*(root,var(16)<=7)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
fall = 0
air.fall = 1
fall.xvelocity = 0
fall.recovertime = 16+13
air.recover = 0
guard.kill = 0
p2facing=1
sprpriority = 4
palfx.color = 0
palfx.add = -72,72,72
palfx.sinadd = 0,72,72,3
palfx.time = 25

