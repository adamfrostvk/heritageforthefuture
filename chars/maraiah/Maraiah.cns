;勝利ポーズ(Winning Pose)
[Statedef 180]
type = S
movetype = I
velset = 0,0
ctrl = 0
sprpriority = 4
anim = 180

[State 180, 0]
type = ChangeState
trigger1 = time=0 && random%3!=0
value = 181+random%2

[State 1000,PlaySnd]
type = PlaySnd
trigger1 = AnimElem=1
value = 180,0+var(49)*100
channel = 1

[state 20180]
type = Helper
trigger1 = !time&&random%3<ifelse(matchover,3,2)
id = 20180
stateno=20180+random%2*5
pos = ifelse((enemynear,pos x>0&&facing=1)||(enemynear,pos X<0&&facing=-1),320+60,0-60),0
postype = back
ignorehitpause=1
ownpal = 1
facing=ifelse(enemynear,pos x>0,-1,1)*facing

[State 190,1]
type = AssertSpecial
trigger1 = Time=[0,200+(matchover)*60]
flag = RoundNotOver

