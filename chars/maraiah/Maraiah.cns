trigger1 = Time=0
Anim = 90000
id = 10013
pos = 0, ceil(24*const(size.yscale))
postype = p1
bindtime = -1
removetime = -1
removeongethit = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)
persistent=0

[State 20, 4]
