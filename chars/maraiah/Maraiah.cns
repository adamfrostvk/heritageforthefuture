;アイアンクラッシュ（車）
[statedef 13105]
type    = A
physics = N
movetype= A
ctrl    = 0
velset  = 0,24
anim    = 13170
sprpriority = 4

[state 13100]
type = AssertSpecial
trigger1 = 1
flag = noshadow

;~~~~ヒット数加算
[state 200]
type = parentvaradd
trigger1 = movehit=1
var(16) = 1

[State 0, HitDef]
type = HitDef
