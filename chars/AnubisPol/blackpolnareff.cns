;Var(3)  = ジャンプ管理1（距離）
;Var(4)  = ジャンプ管理2（高さ）
;Var(5)  = 強弱管理
;Var(6)  = 鬼連斬追加入力
;Var(7)  = 勝ちポーズ分岐
;Var(8)  = スタンド出現中
;Var(9)  = 憶えた技数
;Var(10) = 一度憶えたかどうか判定
;Var(11)～(40) = 「憶えたッ！」用
;Var(41) = ヒット判定
;Var(42) = コンボ数
;Var(43) = カウンターヒット判定
;Var(44) = KO時時間経過
;Var(45) = ライフによる攻撃力補正
;Var(46) = 相手ライフによる攻撃力補正
;Var(47) = 
;Var(48) = ヒット判定（即キャンセル用）
;Var(49) = 
;Var(50) = 
;Var(51) = 
;Var(52) = キャラ判別
;Var(53) = 剣アイコンのX座標
;Var(54) = 剣アイコンのY座標
;Var(55) = 「WINNER」表示ON/OFF
;Var(56) = 「to be continued」表示ON/OFF
;Var(57) = 
;Var(58) = 
;Var(59) = AI判定

;fvar(1) = 攻撃力補正
;fvar(39) = ゲームシステム判別

[Data]
life = 1000
power = 10000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 0
FloatPersistIndex = 0

[Size]
xscale = 1           ;水平方向の縮尺（通常１）
yscale = 1           ;垂直方向の縮尺（通常１）
ground.back = 25     ;キャラの幅(後方,地上)
ground.front = 20    ;キャラの幅(前方,地上)
air.back = 25        ;キャラの幅(後方,空中)
air.front = 20       ;キャラの幅(前方,空中)
height = 65          ;キャラの高さ
attack.dist = 160    ;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist = 90;攻撃をした時相手がガード体制に入る最低距離（飛び道具）
proj.doscale = 0     ;上で設定した縮尺を飛び道具にも適用するか（１でＯＮ）   
head.pos = -5, -91   ;頭の大体の座標
mid.pos = -1, -60    ;体の中心の大体の座標
shadowoffset = 0     ;影の垂直方向のオフセット
draw.offset = 0,0    ;使用しない

[Velocity]
walk.fwd  = 3      ;前進の速度
walk.back = -2.9     ;後退の速度
run.fwd  = 9, 0       ;前ダッシュの速度（ホップする時はyを-にする）
run.back = -10,0     ;後ダッシュの速度（ホップする時はyを-にする）
jump.neu = 0,-9.8      ;垂直ジャンプの速度
jump.back = -2.8;-2.19       ;後ジャンプの速度
jump.fwd = 2.8;2.19         ;前ジャンプの速度
runjump.back = -4.5,-11;-3.4,-11.5;後ダッシュしながらのジャンプ速度(オプション)
runjump.fwd = 4.5,-11;3.4,-11.5   ;前ダッシュしながらのジャンプ速度(オプション)
airjump.neu = 0,-6  ;２段ジャンプ以降の垂直ジャンプの速度(オプション)
airjump.back = -2.8 ;２段ジャンプ以降の後ジャンプの速度(オプション)
airjump.fwd = 2.8    ;２段ジャンプ以降の前ジャンプの速度

[Movement]
airjump.num = 0      ;空中でジャンプする回数
airjump.height = 28  ;空中でジャンプする最低限の高さ
yaccel = .5         ;重力
stand.friction = .85  ;立ち状態の摩擦係数
crouch.friction = .82 ;屈み状態の摩擦係数


;---------------------------------------------------------------------------
;Stand to Crouch
[Statedef 10]
type = C
physics = C
ctrl = 1
anim = 10+var(0)
sprpriority = !var(0)

[State 20000]
type = Helper
trigger1 = time = 0
helpertype = normal
name = "zaxtu"
ID = 20000
pos = 0, 5
postype = p1
facing = facing
stateno = 200000
keyctrl = 0
ownpal = 1
supermovetime = 99999
pausemovetime = 99999
size.xscale = 1
size.yscale = 1
ignorehitpause = 1

[State ???§‘Т?@]
Type = ChangeState
Triggerall = Time = 0
trigger1 = Var(59)
trigger1 = RoundState = 2
trigger2 = Roundstate != 2
Value = 0
Ctrl = 1

[State 0, vel]
type = velmul
trigger1 = !time
x = .75

[State 0, end]
type = changestate
trigger1 = command != "holddown"
value = 12

[State 0, end]
type = changestate
trigger1 = !animtime
value = 11

